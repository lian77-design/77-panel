local function AlternarPainel()
    PainelAberto = not PainelAberto
    Janela.Visible = PainelAberto

    if PainelAberto then
        Janela.Size = UDim2.new(0, 0, 0, 0)

        TweenService:Create(
            Janela,
            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {Size = UDim2.new(0, 520, 0, 380)}
        ):Play()
    end
end

Flutuante.MouseButton1Click:Connect(AlternarPainel)

UserInputService.InputBegan:Connect(function(input, processado)
    if processado then return end

    if input.KeyCode == Enum.KeyCode.J then
        AlternarPainel()
    end
end)

-- =====================================================
-- ARRASTAR BOTAO FLUTUANTE
-- =====================================================

local arrastando = false
local inicio
local posicao

Flutuante.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then

        arrastando = true
        inicio = input.Position
        posicao = Flutuante.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                arrastando = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not arrastando then return end

    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement then

        local delta = input.Position - inicio

        Flutuante.Position = UDim2.new(
            posicao.X.Scale, posicao.X.Offset + delta.X,
            posicao.Y.Scale, posicao.Y.Offset + delta.Y
        )
    end
end)

