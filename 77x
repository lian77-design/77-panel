local function ownHum() local ch=LP.Character; return ch and ch:FindFirstChildOfClass('Humanoid') end
local function restoreCamera() local cam=workspace.CurrentCamera; local hum=ownHum(); if cam and hum then cam.CameraType=Enum.CameraType.Custom; cam.CameraSubject=hum end end

local function stopFollow()
 following=false
 if followConn then followConn:Disconnect(); followConn=nil end
 local hum=ownHum(); if hum then hum:Move(Vector3.zero,false) end
 if not spectating then restoreCamera() end
end
local function stopSpectate() spectating=false; if not following then restoreCamera() end end

local function validRoot(p)
 if not p or p.Parent~=Players then return nil end
 local ch=p.Character; local hum=ch and ch:FindFirstChildOfClass('Humanoid'); local root=ch and ch:FindFirstChild('HumanoidRootPart')
 if not root or not hum or hum.Health<=0 then return nil end
 return root,hum
end

local function tpTo(p)
 local mine=validRoot(LP); local target=validRoot(p)
 if not mine or not target then notify('TP','Personagem indisponivel',C.Vermelho); return end
 mine.CFrame=target.CFrame*CFrame.new(0,0,3); notify('TP','Movimento local solicitado',C.Verde)
end

local function startFollow(p)
 if not validRoot(LP) or not validRoot(p) then notify('FOLLOW','Jogador indisponivel',C.Vermelho); return false end
 stopSpectate(); stopFollow(); following=true
 followConn=RunService.Heartbeat:Connect(function()
  if not alive or not following then return end
  local mine,hum=validRoot(LP); local theirs,targetHum=validRoot(p)
  if not mine or not hum or not theirs or not targetHum then stopFollow(); return end
  mine.CFrame=theirs.CFrame*CFrame.new(0,0,3)
  mine.AssemblyLinearVelocity=theirs.AssemblyLinearVelocity
  if targetHum:GetState()==Enum.HumanoidStateType.Jumping then hum.Jump=true end
 end)
 return true
end

local function startSpectate(p)
 local _,hum=validRoot(p)
 if not hum then notify('ESPECTAR','Jogador indisponivel',C.Vermelho); return false end
 stopFollow(); spectating=true
 local cam=workspace.CurrentCamera; if cam then cam.CameraType=Enum.CameraType.Custom; cam.CameraSubject=hum end
 return true
end

conn(RunService.Heartbeat,function()
 if not alive or not spectating then return end
 local _,hum=validRoot(selected); if not hum then stopSpectate(); return end
 local cam=workspace.CurrentCamera; if cam and cam.CameraSubject~=hum then cam.CameraSubject=hum end
end)

