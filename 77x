end

local function esconderESP(p)
    local d = espDados[p.UserId]
    if not d then return end
    d.bbBox.Enabled = false
    d.bbNome.Enabled = false
end

local function limparTodosESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then esconderESP(p) end
    end
end

local function calcularBox2D(char)
    local minX, minY =  math.huge,  math.huge
    local maxX, maxY = -math.huge, -math.huge
    local algumVisible = false

    for _, nome in ipairs(PARTES_NOME) do
        local part = char:FindFirstChild(nome)
        if part and part:IsA("BasePart") then
            local size = part.Size
            local cf   = part.CFrame
            local hx, hy, hz = size.X/2, size.Y/2, size.Z/2
            local corners = {
                cf:PointToWorldSpace(Vector3.new( hx,  hy,  hz)),
                cf:PointToWorldSpace(Vector3.new(-hx,  hy,  hz)),
                cf:PointToWorldSpace(Vector3.new( hx, -hy,  hz)),
                cf:PointToWorldSpace(Vector3.new(-hx, -hy,  hz)),
                cf:PointToWorldSpace(Vector3.new( hx,  hy, -hz)),
                cf:PointToWorldSpace(Vector3.new(-hx,  hy, -hz)),
                cf:PointToWorldSpace(Vector3.new( hx, -hy, -hz)),
                cf:PointToWorldSpace(Vector3.new(-hx, -hy, -hz)),
            }
            for _, wp in ipairs(corners) do
                local sp, onScreen = Camera:WorldToViewportPoint(wp)
                if onScreen and sp.Z > 0 then
                    algumVisible = true
                    if sp.X < minX then minX = sp.X end
                    if sp.Y < minY then minY = sp.Y end
                    if sp.X > maxX then maxX = sp.X end
                    if sp.Y > maxY then maxY = sp.Y end
                end
            end
        end
    end

    if not algumVisible then return nil end
    return minX, minY, maxX, maxY
end

local function atualizarESP(p, localRoot)
    local d = espDados[p.UserId]
    if not d then return end

    local char = p.Character
    if not char then esconderESP(p) return end

    local root     = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then
        esconderESP(p) return
    end

    local dist = 0
    if localRoot then
        dist = (root.Position - localRoot.Position).Magnitude
        if dist > DISTANCIA_MAX then
            esconderESP(p) return
        end
    end

    local _, onScreen = Camera:WorldToViewportPoint(root.Position)
    if not onScreen then esconderESP(p) return end

    local minX, minY, maxX, maxY = calcularBox2D(char)
    if not minX then esconderESP(p) return end

    local largura = maxX - minX
    local altura  = maxY - minY
    if largura <= 0 or altura <= 0 then esconderESP(p) return end

    d.bbBox.Size = UDim2.new(0, largura + 4, 0, altura + 4)
    d.bbBox.Enabled = true

    d.label.Text = p.DisplayName .. "  [" .. math.floor(dist) .. "m]"
    d.bbNome.Enabled = true
end

local conexaoESP = nil

local function iniciarLoopESP()
    if conexaoESP then return end
    conexaoESP = RunService.RenderStepped:Connect(function()
        if not espAtivo then return end

        Camera = workspace.CurrentCamera

        local localRoot = LocalPlayer.Character
            and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if not espDados[p.UserId] then criarESP(p) end
                atualizarESP(p, localRoot)
            end
        end
    end)
end

iniciarLoopESP()

