            PlaceholderColor3 = Cores.Cinza,
            TextColor3 = Cores.Branco,
            Font = Enum.Font.Gotham,
            TextSize = 13,
            ClearTextOnFocus = false,
            BorderSizePixel = 0
        }, Area)
        Arredondar(pesquisa, 7)

        local tp = Botao(
            Area, "TELEPORTAR",
            UDim2.new(0, 10, 0, 52),
            UDim2.new(0.38, -5, 0, 35)
        )

        local spec = Botao(
            Area, "ESPECTAR",
            UDim2.new(0.38, 10, 0, 52),
            UDim2.new(0.32, -5, 0, 35)
        )

        local anterior = Botao(
            Area, "◀",
            UDim2.new(0.70, 5, 0, 52),
            UDim2.new(0.14, -5, 0, 35)
        )

        local proximo = Botao(
            Area, "▶",
            UDim2.new(0.84, 5, 0, 52),
            UDim2.new(0.16, -15, 0, 35)
        )

        anterior.TextSize = 18
        proximo.TextSize = 18
        anterior.BackgroundColor3 = Cores.Lilas
        proximo.BackgroundColor3 = Cores.Lilas

        local status = Criar("TextLabel", {
            Size = UDim2.new(1, -20, 0, 22),
            Position = UDim2.new(0, 10, 0, 91),
            BackgroundTransparency = 1,
            Text = "Selecione um jogador",
            TextColor3 = Cores.Lilas,
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextTruncate = Enum.TextTruncate.AtEnd
        }, Area)

        local scroll = Criar("ScrollingFrame", {
            Size = UDim2.new(1, -20, 1, -125),
            Position = UDim2.new(0, 10, 0, 116),
            BackgroundColor3 = Cores.Secundario,
            BorderSizePixel = 0,
            ScrollBarThickness = 4,
            CanvasSize = UDim2.new(0, 0, 0, 0)
        }, Area)
        Arredondar(scroll, 7)

        local layout = Criar("UIListLayout", {
            Padding = UDim.new(0, 4),
            SortOrder = Enum.SortOrder.Name
        }, scroll)

        local function ObterJogadores()
            local lista = {}

            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer
                    and string.find(
                        string.lower(player.Name),
                        string.lower(pesquisa.Text),
                        1,
                        true
                    ) then
                    table.insert(lista, player)
                end
            end

            table.sort(lista, function(a, b)
                return string.lower(a.Name) < string.lower(b.Name)
            end)

            return lista
        end

        local function Atualizar()
            for _, obj in ipairs(scroll:GetChildren()) do
                if obj:IsA("TextButton") then
                    obj:Destroy()
                end
            end

            local lista = ObterJogadores()

            if AlvoSelecionado and AlvoSelecionado.Parent ~= Players then
                AlvoSelecionado = nil
            end

            if Espectando and
                (not JogadorEspectado or JogadorEspectado.Parent ~= Players) then
                EncerrarEspectador()
                spec.Text = "ESPECTAR"
            end

            for _, player in ipairs(lista) do
                local jogador = player

                local b = Botao(
                    scroll,
                    jogador.Name,
                    UDim2.new(),
                    UDim2.new(1, -8, 0, 32)
                )

                b.Name = jogador.Name
                b.BackgroundColor3 =
                    AlvoSelecionado == jogador and Cores.Roxo or Cores.Fundo

                b.MouseButton1Click:Connect(function()
                    AlvoSelecionado = jogador

                    if Espectando then
                        JogadorEspectado = jogador
                        AtualizarCamera()
                    end

                    Atualizar()
                end)
            end

            if Espectando and JogadorEspectado then
                status.Text = "Espectando: " .. JogadorEspectado.Name
            elseif AlvoSelecionado then
                status.Text = "Selecionado: " .. AlvoSelecionado.Name
            else
                status.Text = #lista == 0
                    and "Nenhum jogador disponível"
                    or "Selecione um jogador"
            end

            task.defer(function()
                if layout and layout.Parent then
                    scroll.CanvasSize = UDim2.new(
                        0, 0, 0, layout.AbsoluteContentSize.Y + 5
                    )
                end
            end)
        end

        AtualizarLista = Atualizar

        local function SelecionarJogador(player)
            if not player or player == LocalPlayer then return end

            AlvoSelecionado = player

            if Espectando then
                JogadorEspectado = player
                AtualizarCamera()
            end

            Atualizar()
        end

        local function MudarJogador(direcao)
            local lista = ObterJogadores()

            if #lista == 0 then
                status.Text = "Nenhum jogador disponível"
                return
            end

            local atual = Espectando and JogadorEspectado or AlvoSelecionado
            local indice = table.find(lista, atual)

            if not indice then
                indice = direcao == 1 and 0 or 1
            end

            indice = ((indice - 1 + direcao) % #lista) + 1

            SelecionarJogador(lista[indice])
        end

        pesquisa:GetPropertyChangedSignal("Text"):Connect(Atualizar)

        anterior.MouseButton1Click:Connect(function()
            MudarJogador(-1)
        end)

        proximo.MouseButton1Click:Connect(function()
            MudarJogador(1)
        end)

        tp.MouseButton1Click:Connect(function()
            local alvo = AlvoSelecionado
            local meuChar = LocalPlayer.Character
            local alvoChar = alvo and alvo.Character

            local meuRoot = meuChar
                and meuChar:FindFirstChild("HumanoidRootPart")

            local alvoRoot = alvoChar
                and alvoChar:FindFirstChild("HumanoidRootPart")

            if meuRoot and alvoRoot then
                meuRoot.CFrame = alvoRoot.CFrame * CFrame.new(0, 0, 3)
            else
                status.Text = "Personagem indisponível"
            end
        end)

        spec.MouseButton1Click:Connect(function()
            if Espectando then
                EncerrarEspectador()
                spec.Text = "ESPECTAR"
                Atualizar()
                return
            end

            local alvo = AlvoSelecionado
            local char = alvo and alvo.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")

            if not alvo or alvo.Parent ~= Players then
                status.Text = "Selecione um jogador válido"
                return
            end

            if not humanoid then
                status.Text = "Aguardando personagem do jogador"
                return
            end

            Espectando = true
            JogadorEspectado = alvo
            workspace.CurrentCamera.CameraSubject = humanoid

            spec.Text = "PARAR"
            Atualizar()
        end)

        Atualizar()

    elseif nome == "Misc" then
        local espBotao = Botao(
            Area,
            espAtivo and "ESP: ON" or "ESP: OFF",
            UDim2.new(0.1, 0, 0, 20),
            UDim2.new(0.8, 0, 0, 40)
        )

        espBotao.BackgroundColor3 =
            espAtivo and Cores.Lilas or Cores.Roxo

        espBotao.MouseButton1Click:Connect(function()
            espAtivo = not espAtivo

            if espAtivo then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then criarESP(p) end
                end
                espBotao.Text = "ESP: ON"
                espBotao.BackgroundColor3 = Cores.Lilas
                notificar("ESP ATIVADO", "Range: " .. DISTANCIA_MAX .. " studs", Cores.Lilas)
            else
                limparTodosESP()
                espBotao.Text = "ESP: OFF"
                espBotao.BackgroundColor3 = Cores.Roxo
                notificar("ESP DESATIVADO", "Toque no botão para ativar", Color3.fromRGB(60, 60, 60))
            end
        end)

        local afkBotao = Botao(
            Area,
            AntiAFKAtivo and "ANTI-AFK: ON" or "ANTI-AFK: OFF",
            UDim2.new(0.1, 0, 0, 70),
            UDim2.new(0.8, 0, 0, 40)
        )

        afkBotao.BackgroundColor3 =
            AntiAFKAtivo and Cores.Lilas or Cores.Roxo

        afkBotao.MouseButton1Click:Connect(function()
            AntiAFKAtivo = not AntiAFKAtivo
            afkBotao.Text = AntiAFKAtivo
                and "ANTI-AFK: ON" or "ANTI-AFK: OFF"

            afkBotao.BackgroundColor3 =
                AntiAFKAtivo and Cores.Lilas or Cores.Roxo
        end)

        local airBotao = Botao(
            Area,
            airwalkOn and "AIRWALK: ON" or "AIRWALK: OFF",
            UDim2.new(0.1, 0, 0, 120),
            UDim2.new(0.8, 0, 0, 40)
        )

        airBotao.BackgroundColor3 =
            airwalkOn and Cores.Lilas or Cores.Roxo

        airBotao.MouseButton1Click:Connect(function()
            if not airwalkOn then
                local ok = ligarAirWalk()
                if ok then
                    airBotao.Text = "AIRWALK: ON"
                    airBotao.BackgroundColor3 = Cores.Lilas
                end
            else
                desligarAirWalk()
                airBotao.Text = "AIRWALK: OFF"
                airBotao.BackgroundColor3 = Cores.Roxo
            end
        end)

        Criar("TextLabel", {
            Size = UDim2.new(0.9, 0, 0, 60),
            Position = UDim2.new(0.05, 0, 0, 165),
            BackgroundTransparency = 1,
            Text = "ESP: toque no botão para ligar/desligar\nAirWalk: Espaço/Ctrl no PC | ⬆️⬇️ no mobile",
            TextColor3 = Cores.Lilas,
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextWrapped = true
        }, Area)

    elseif nome == "About" then
        Criar("TextLabel", {
            Size = UDim2.new(1, -20, 0, 100),
            Position = UDim2.new(0, 10, 0, 20),
            BackgroundTransparency = 1,
