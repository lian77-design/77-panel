local function RestaurarCamera()
    local cam = workspace.CurrentCamera
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")

    if cam and humanoid then
        cam.CameraSubject = humanoid
    end
end

EncerrarEspectador = function()
    Espectando = false
    JogadorEspectado = nil
    RestaurarCamera()
end

local function AtualizarCamera()
    if not Espectando then return end

    local cam = workspace.CurrentCamera
    local alvo = JogadorEspectado

    if not cam then return end

    if not alvo or alvo.Parent ~= Players then
        EncerrarEspectador()
        return
    end

    local char = alvo.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")

    if humanoid and cam.CameraSubject ~= humanoid then
        cam.CameraSubject = humanoid
    end
end

RunService.RenderStepped:Connect(AtualizarCamera)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if Espectando then
        AtualizarCamera()
    else
        RestaurarCamera()
    end
end)

