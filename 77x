-- ESP (mostra invisíveis)
-- =========================================================
local espObjects,partsCache={},{}
local ESP_RANGE,ESP_INTERVAL,espTimer=500,.05,0
local PARTS_REFRESH=1.0
local COR_CAIXA=Color3.fromRGB(60,25,105)
local COR_TEXTO=Color3.fromRGB(180,130,240)

local espGui=new('ScreenGui',{Name='77ESP',ResetOnSpawn=false,IgnoreGuiInset=true,DisplayOrder=5},PG)
local camera=workspace.CurrentCamera
conn(workspace:GetPropertyChangedSignal('CurrentCamera'),function() camera=workspace.CurrentCamera end)

local function removeESP(p)
 local d=espObjects[p]; if not d then return end
 if d.bbBox then d.bbBox:Destroy() end
 if d.bbNome then d.bbNome:Destroy() end
 if d.char then partsCache[d.char]=nil end
 espObjects[p]=nil
end
local function hideESP(d) d.bbBox.Enabled=false; d.bbNome.Enabled=false end

local function createESP(p)
 if p==LP or espObjects[p] then return end
 local ch=p.Character; if not ch or not ch:FindFirstChild('Head') then return end
 local bbBox=new('BillboardGui',{Name='77Box',Adornee=ch,Size=UDim2.fromOffset(100,100),AlwaysOnTop=true,LightInfluence=0,MaxDistance=1000,ClipsDescendants=false},espGui)
 local box=new('Frame',{Name='Box',Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0},bbBox)
 new('UIStroke',{Color=COR_CAIXA,Thickness=2,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},box)
 local bbNome=new('BillboardGui',{Name='77Nome',Adornee=ch.Head,Size=UDim2.fromOffset(200,22),StudsOffsetWorldSpace=Vector3.new(0,2.5,0),AlwaysOnTop=true,LightInfluence=0,MaxDistance=1000},espGui)
 local txt=new('TextLabel',{Name='Nome',Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text='',TextColor3=COR_TEXTO,TextStrokeTransparency=.2,TextStrokeColor3=Color3.new(0,0,0),Font=Enum.Font.GothamBold,TextSize=14,TextTruncate=Enum.TextTruncate.AtEnd},bbNome)
 espObjects[p]={bbBox=bbBox,bbNome=bbNome,label=txt,char=ch}
end

local function visibleParts(ch)
 local c=partsCache[ch]
 local now=os.clock()
 if c and (now-c.t)<PARTS_REFRESH then return c.list end
 local list={}; local root=ch:FindFirstChild('HumanoidRootPart')
 for _,obj in ipairs(ch:GetDescendants()) do
  if obj:IsA('BasePart') then
   local skip=false; local parent=obj.Parent
   while parent and parent~=ch do
    if parent:IsA('Tool') then skip=true; break end
    parent=parent.Parent
   end
   if not skip and obj.Name~='Handle'
    and (not root or (obj.Position-root.Position).Magnitude<=10) then
    table.insert(list,obj)
   end
  end
 end
 partsCache[ch]={list=list,t=now}
 return list
end

local function calculateBox(ch)
 if not camera then return nil end
 local minX,minY,maxX,maxY=math.huge,math.huge,-math.huge,-math.huge
 local visible=false
 for _,part in ipairs(visibleParts(ch)) do
  if part.Parent then
   local sz,cf=part.Size,part.CFrame
   for _,x in ipairs({-sz.X/2,sz.X/2}) do
    for _,y in ipairs({-sz.Y/2,sz.Y/2}) do
     for _,z in ipairs({-sz.Z/2,sz.Z/2}) do
      local point,onScreen=camera:WorldToViewportPoint(cf:PointToWorldSpace(Vector3.new(x,y,z)))
      if onScreen and point.Z>0 then
       visible=true
       minX=math.min(minX,point.X); minY=math.min(minY,point.Y)
       maxX=math.max(maxX,point.X); maxY=math.max(maxY,point.Y)
      end
     end
    end
   end
  end
 end
 if visible then return minX,minY,maxX,maxY end
end

local function updateESP(p,ownRoot)
 local d=espObjects[p]; if not d then return end
 local ch=p.Character; if not ch or ch~=d.char then hideESP(d); return end
 local root=ch:FindFirstChild('HumanoidRootPart'); local hum=ch:FindFirstChildOfClass('Humanoid')
 if not root or not hum or hum.Health<=0 or not camera then hideESP(d); return end
 local distance=ownRoot and (root.Position-ownRoot.Position).Magnitude or 0
 if distance>ESP_RANGE then hideESP(d); return end
 local _,onScreen=camera:WorldToViewportPoint(root.Position)
 if not onScreen then hideESP(d); return end
 local minX,minY,maxX,maxY=calculateBox(ch)
 if not minX then hideESP(d); return end
 local width,height=maxX-minX,maxY-minY
 if width<=0 or height<=0 then hideESP(d); return end
 d.bbBox.Size=UDim2.fromOffset(width+4,height+4); d.bbBox.Enabled=true
 local display=p.DisplayName; if #display>20 then display=string.sub(display,1,20)..'...' end
 d.label.Text=display..' ['..math.floor(distance)..'m]'; d.bbNome.Enabled=true
end

conn(RunService.Heartbeat,function(dt)
 if not alive or not espOn then return end
 espTimer+=dt; if espTimer<ESP_INTERVAL then return end; espTimer=0
 local ownRoot=LP.Character and LP.Character:FindFirstChild('HumanoidRootPart')
 for _,p in ipairs(Players:GetPlayers()) do
  if p~=LP then
   if espObjects[p] and espObjects[p].char~=p.Character then removeESP(p) end
   if not espObjects[p] then createESP(p) end
   updateESP(p,ownRoot)
  end
 end
end)

local function toggleESP()
 espOn=not espOn
 if espOn then
  for _,p in ipairs(Players:GetPlayers()) do if p~=LP then createESP(p) end end
 else
  for p in pairs(espObjects) do removeESP(p) end
 end
 notify('ESP',espOn and 'ESP ativado' or 'ESP desativado',C.Lilas)
end

