local function Criar(classe, props, pai)
    local obj = Instance.new(classe)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = pai
    return obj
end

local function Arredondar(obj, raio)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, raio)
    c.Parent = obj
end

