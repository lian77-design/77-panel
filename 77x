local function stopAir()
 airOn=false; upHeld=false; downHeld=false
 if airConn then airConn:Disconnect(); airConn=nil end
 if airFloor then airFloor:Destroy(); airFloor=nil end
 if airControls then airControls:Destroy(); airControls=nil end
end

local function startAir()
 local root,hum=validRoot(LP)
 if not root then notify('AIRWALK','Personagem indisponivel',C.Vermelho); return false end
 stopAir(); airOn=true
 airFloor=new('Part',{Name='77AirwalkFloor',Anchored=true,CanCollide=true,CanTouch=false,CanQuery=false,Transparency=1,Size=Vector3.new(18,1,18),CFrame=CFrame.new(root.Position.X,root.Position.Y-hum.HipHeight-2,root.Position.Z)},workspace)
 local targetY=airFloor.Position.Y
 if UIS.TouchEnabled then
  airControls=new('ScreenGui',{Name='77AirwalkControls',ResetOnSpawn=false,DisplayOrder=1000},PG)
  local up=button(airControls,'UP',UDim2.new(1,-65,.42,0),UDim2.fromOffset(52,45),C.Sec)
  local down=button(airControls,'DOWN',UDim2.new(1,-65,.62,0),UDim2.fromOffset(52,45),C.Sec)
  local function hold(b,fn)
   local heldInput=nil
   conn(b.InputBegan,function(i) if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then heldInput=i; fn(true) end end)
   conn(UIS.InputEnded,function(i) if i==heldInput then heldInput=nil; fn(false) end end)
  end
  hold(up,function(v) upHeld=v end); hold(down,function(v) downHeld=v end)
 end
 airConn=RunService.Heartbeat:Connect(function(dt)
  local r=validRoot(LP)
  if not alive or not airOn or not r or not airFloor then stopAir(); return end
  if upHeld or UIS:IsKeyDown(Enum.KeyCode.Space) then targetY+=8*dt end
  if downHeld or UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then targetY-=8*dt end
  airFloor.CFrame=CFrame.new(r.Position.X,targetY,r.Position.Z)
 end)
 return true
end

conn(LP.CharacterAdded,function() stopAir(); stopFollow(); stopSpectate() end)

