local function removerBotoesMobile()
    subindoMobile = false
    descendoMobile = false
    if airwalkMobileGui then
        airwalkMobileGui:Destroy()
        airwalkMobileGui = nil
    end
end

local function desligarAirWalk()
    airwalkOn = false

    if airwalkConnection then
        airwalkConnection:Disconnect()
        airwalkConnection = nil
    end

    if workspace:FindFirstChild("AirwalkFloor") then
        workspace.AirwalkFloor:Destroy()
    end

    removerBotoesMobile()
end

local function ligarAirWalk()
    local char = LocalPlayer.Character
    if not char then return false end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    airwalkOn = true

    local fakePart = Instance.new("Part", workspace)
    fakePart.Name = "AirwalkFloor"
    fakePart.Anchored = true
    fakePart.CanCollide = true
    fakePart.Transparency = 1
    fakePart.Size = Vector3.new(50, 1, 50)
    fakePart.CFrame = CFrame.new(
        hrp.Position.X,
        hrp.Position.Y - (hum.HipHeight + 1.5),
        hrp.Position.Z
    )

    local targetY = fakePart.Position.Y

    if UserInputService.TouchEnabled then
        criarBotoesMobile()
    end

    airwalkConnection = RunService.Heartbeat:Connect(function()
        if not airwalkOn then return end

        local c = LocalPlayer.Character
        if not c then return end

        local r = c:FindFirstChild("HumanoidRootPart")
        if not r then return end

        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or subindoMobile then
            targetY = targetY + 0.3
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
            or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
            or descendoMobile then
            targetY = targetY - 0.3
        end

        local piso = workspace:FindFirstChild("AirwalkFloor")
        if piso then
            piso.CFrame = CFrame.new(r.Position.X, targetY, r.Position.Z)
        end
    end)

    return true
end

LocalPlayer.CharacterAdded:Connect(function()
    if airwalkOn then
        desligarAirWalk()
    end
end)

