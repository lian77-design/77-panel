	local function buscarTotalUsuarios()
		local res = httpRequest({Url=SERVIDOR.."/getregistered?gameId="..GAME_ID, Method="GET"})
		if res and res.Body then
			local ok, dados = pcall(function() return HttpService:JSONDecode(res.Body) end)
			if ok and dados and dados.total then
				return dados.total
			end
		end
		local res2 = httpRequest({Url=SERVIDOR.."/gettags?gameId="..GAME_ID, Method="GET"})
		if res2 and res2.Body then
			local ok, dados = pcall(function() return HttpService:JSONDecode(res2.Body) end)
			if ok and dados and type(dados) == "table" then
				local count = 0
				for _ in pairs(dados) do count = count + 1 end
				return count
			end
		end
		return 0
	end
	
