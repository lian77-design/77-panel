			frame.Position         = UDim2.new(0, 0, 0, yPos)
			frame.BackgroundColor3 = eSel and Color3.fromRGB(55,15,15) or Color3.fromRGB(28,28,28)
			frame.BorderSizePixel  = 0
			frame.ClipsDescendants = false
			frame.Parent           = staffScroll
			Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
	
			local stroke = Instance.new("UIStroke", frame)
			stroke.Color       = eSel and Color3.fromRGB(200,40,40) or Color3.fromRGB(50,50,50)
			stroke.Thickness   = 1
	
			local borda = Instance.new("Frame", frame)
			borda.Size             = UDim2.new(0, 3, 0.7, 0)
			borda.Position         = UDim2.new(0, 0, 0.15, 0)
			borda.BackgroundColor3 = corTag
			borda.BorderSizePixel  = 0
			Instance.new("UICorner", borda).CornerRadius = UDim.new(0, 3)
	
			local avatarImg = Instance.new("ImageLabel", frame)
