	local UserInputService = game:GetService("UserInputService")
	local Players          = game:GetService("Players")
	local TweenService     = game:GetService("TweenService")
	
	local player      = Players.LocalPlayer
	local botao       = script.Parent
	local iconeStatus = botao:WaitForChild("TextLabel")
	
	local permissaoPainel = false
	local spinAtivo       = false
	local bAV             = nil
	local conexaoVel      = nil   -- loop que ajusta velocidade com Ctrl
	
	local VEL_NORMAL  = 2     -- velocidade normal
	local VEL_RAPIDA  = 25    -- velocidade com Ctrl segurado
	
	-- Controle do botão CTRL no mobile
	local ctrlMobilePressionado = false
	local mobileGui = nil
	
	-- Verifica se é Mobile / Touch
	local isMobile = UserInputService.TouchEnabled
	
	-- ============================================================
	-- NOTIFICAÇÃO
	-- ============================================================
	local pGui = player:WaitForChild("PlayerGui")
	local notifSg = pGui:FindFirstChild("NotifSpin")
	if notifSg then notifSg:Destroy() end
	notifSg = Instance.new("ScreenGui", pGui)
	notifSg.Name = "NotifSpin"
	notifSg.ResetOnSpawn = false
	
	local function notificar(titulo, texto, cor)
		cor = cor or Color3.fromRGB(120, 0, 0)
		for _, f in pairs(notifSg:GetChildren()) do
			if f:IsA("Frame") then f:Destroy() end
		end
		local frame = Instance.new("Frame", notifSg)
		frame.Size             = UDim2.new(0, 270, 0, 64)
		frame.Position         = UDim2.new(1, 10, 1, -20)
		frame.AnchorPoint      = Vector2.new(1, 1)
		frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
		frame.BackgroundTransparency = 0.08
		frame.BorderSizePixel  = 0
		frame.ZIndex           = 10
		Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
	
		local bd = Instance.new("Frame", frame)
		bd.Size = UDim2.new(0, 4, 1, 0)
		bd.Position = UDim2.new(1, -4, 0, 0)
		bd.BackgroundColor3 = cor
		bd.BorderSizePixel = 0
		bd.ZIndex = 11
		Instance.new("UICorner", bd).CornerRadius = UDim.new(0, 8)
	
		local lT = Instance.new("TextLabel", frame)
		lT.Size = UDim2.new(1, -20, 0, 26)
		lT.Position = UDim2.new(0, 12, 0, 8)
		lT.BackgroundTransparency = 1
		lT.Text = titulo
		lT.TextColor3 = Color3.fromRGB(255, 255, 255)
		lT.Font = Enum.Font.GothamBold
		lT.TextSize = 13
		lT.TextXAlignment = Enum.TextXAlignment.Left
		lT.ZIndex = 11
	
		local lS = Instance.new("TextLabel", frame)
		lS.Size = UDim2.new(1, -20, 0, 18)
		lS.Position = UDim2.new(0, 12, 0, 34)
		lS.BackgroundTransparency = 1
		lS.Text = texto
		lS.TextColor3 = Color3.fromRGB(200, 200, 200)
		lS.Font = Enum.Font.Gotham
		lS.TextSize = 11
		lS.TextXAlignment = Enum.TextXAlignment.Left
		lS.ZIndex = 11
	
		TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.new(1, -16, 1, -20)
		}):Play()
	
		task.delay(3.5, function()
			TweenService:Create(frame, TweenInfo.new(0.3), {
				Position = UDim2.new(1, 10, 1, -20)
			}):Play()
			task.wait(0.35)
			if frame and frame.Parent then frame:Destroy() end
		end)
	end
	
	-- ============================================================
	-- CRIAR CONTROLES MOBILE ([M] e [CTRL])
	-- ============================================================
	local function criarControlesMobile()
		if pGui:FindFirstChild("SpinMobileUI") then
			pGui.SpinMobileUI:Destroy()
		end
	
		mobileGui = Instance.new("ScreenGui")
		mobileGui.Name = "SpinMobileUI"
		mobileGui.ResetOnSpawn = false
		mobileGui.Enabled = false
		mobileGui.Parent = pGui
	
		-- Container dos botões
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(0, 160, 0, 70)
		frame.Position = UDim2.new(1, -180, 0.5, 20)
		frame.BackgroundTransparency = 1
		frame.Parent = mobileGui
	
		-- Botão M (Alternar Giro)
		local btnM = Instance.new("TextButton")
		btnM.Name = "BtnM"
		btnM.Size = UDim2.new(0, 65, 0, 65)
		btnM.Position = UDim2.new(0, 0, 0, 0)
		btnM.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		btnM.TextColor3 = Color3.fromRGB(255, 255, 255)
		btnM.TextScaled = true
		btnM.Font = Enum.Font.SourceSansBold
		btnM.Text = "M"
		btnM.Parent = frame
		Instance.new("UICorner", btnM).CornerRadius = UDim.new(1, 0)
	
		-- Botão CTRL (Girar Mais Rápido)
		local btnCtrl = Instance.new("TextButton")
		btnCtrl.Name = "BtnCtrl"
		btnCtrl.Size = UDim2.new(0, 65, 0, 65)
		btnCtrl.Position = UDim2.new(1, -65, 0, 0)
		btnCtrl.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		btnCtrl.TextColor3 = Color3.fromRGB(255, 255, 255)
		btnCtrl.TextScaled = true
		btnCtrl.Font = Enum.Font.SourceSansBold
		btnCtrl.Text = "CTRL"
		btnCtrl.Parent = frame
		Instance.new("UICorner", btnCtrl).CornerRadius = UDim.new(1, 0)
	
		-- Clique no botão M
		btnM.MouseButton1Click:Connect(function()
			if not permissaoPainel then return end
			spinAtivo = not spinAtivo
			if spinAtivo then
				iniciarSpin()
			else
				removerForca()
				notificar("SPIN DESATIVADO", "Pressione [M] para ligar", Color3.fromRGB(60, 60, 60))
			end
		end)
	
		-- Segurar/Soltar o botão CTRL
		btnCtrl.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				ctrlMobilePressionado = true
				btnCtrl.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
			end
		end)
	
		btnCtrl.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				ctrlMobilePressionado = false
				btnCtrl.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
			end
		end)
	end
	
	-- Cria os controles se o dispositivo tiver touch
	if isMobile then
		criarControlesMobile()
	end
	
	-- ============================================================
	-- REMOVER FORÇA
	-- ============================================================
	function removerForca()
		if conexaoVel then
			conexaoVel:Disconnect()
			conexaoVel = nil
		end
		if bAV then
			pcall(function() bAV:Destroy() end)
			bAV = nil
		end
	
		local char = player.Character
		if char then
			local root = char:FindFirstChild("HumanoidRootPart")
			if root then
				for _, obj in pairs(root:GetChildren()) do
					if obj.Name == "SpinForce" then
						pcall(function() obj:Destroy() end)
					end
				end
			end
		end
	end
	
	-- ============================================================
	-- INICIAR GIRO
	-- ============================================================
	function iniciarSpin()
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end
	
		removerForca()
	
		bAV = Instance.new("BodyAngularVelocity")
		bAV.Name           = "SpinForce"
		bAV.MaxTorque      = Vector3.new(0, math.huge, 0)
		bAV.P              = 1500
		bAV.AngularVelocity = Vector3.new(0, VEL_NORMAL, 0)
		bAV.Parent         = root
	
		-- Loop ajusta velocidade via teclado (PC) ou touch (Mobile)
		conexaoVel = RunService.Heartbeat:Connect(function()
			if not spinAtivo or not bAV or not bAV.Parent then return end
	
			local ctrlPressionado = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
				or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
				or ctrlMobilePressionado
	
			local velAlvo = ctrlPressionado and VEL_RAPIDA or VEL_NORMAL
	
			if bAV.AngularVelocity.Y ~= velAlvo then
				bAV.AngularVelocity = Vector3.new(0, velAlvo, 0)
			end
		end)
	
		notificar("SPIN ATIVADO", "[M] desligar | [Ctrl] + rápido", Color3.fromRGB(120, 0, 0))
	end
	
	-- ============================================================
	-- BOTÃO DO PAINEL (LIBERAR/BLOQUEAR)
	-- ============================================================
	iconeStatus.TextColor3 = Color3.fromRGB(255, 0, 0) -- Inicia em Vermelho
	
	botao.MouseButton1Click:Connect(function()
		permissaoPainel = not permissaoPainel
		if permissaoPainel then
			iconeStatus.TextColor3 = Color3.fromRGB(0, 255, 0)
			notificar("SPIN LIBERADO", "[M] para ligar/desligar", Color3.fromRGB(120, 0, 0))
	
			-- Garante que cria e ativa a UI se estiver no mobile
			if not mobileGui and isMobile then
				criarControlesMobile()
			end
			if mobileGui then 
				mobileGui.Enabled = true 
			end
		else
			iconeStatus.TextColor3 = Color3.fromRGB(255, 0, 0)
			spinAtivo = false
			removerForca()
			notificar("SPIN BLOQUEADO", "Desativado pelo painel", Color3.fromRGB(60, 60, 60))
	
			if mobileGui then 
				mobileGui.Enabled = false 
			end
		end
	end)
	
	-- ============================================================
	-- TECLA [M] (PC)
	-- ============================================================
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if not permissaoPainel then return end
		if input.KeyCode == Enum.KeyCode.M then
			spinAtivo = not spinAtivo
			if spinAtivo then
				iniciarSpin()
			else
				removerForca()
				notificar("SPIN DESATIVADO", "Pressione [M] para ligar", Color3.fromRGB(60, 60, 60))
			end
		end
	end)
	
	-- ============================================================
	-- RESETA AO MORRER
	-- ============================================================
	player.CharacterAdded:Connect(function()
		spinAtivo = false
		permissaoPainel = false
		ctrlMobilePressionado = false
		removerForca()
	
		iconeStatus.TextColor3 = Color3.fromRGB(255, 0, 0)
		if mobileGui then mobileGui.Enabled = false end
	end)
end;
