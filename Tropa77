		tagdataBtn.MouseButton1Click:Connect(function()
			if tagSelecionada=="" then notificar("TAGDATA","Selecione uma tag primeiro!",3,"USER") return end
			local nick=tagdataInput and tagdataInput.Text or ""
			nick=nick:gsub("^%s*(.-)%s*$","%1")
			if nick=="" then notificar("TAGDATA","Digite o nick do player!",3,"USER") return end
			local dataStr=tagdataDate and tagdataDate.Text or ""
			dataStr=dataStr:gsub("^%s*(.-)%s*$","%1")
			local expireTs=dataParaTimestamp(dataStr)
			if not expireTs then notificar("TAGDATA","Data inválida! Use DD/MM/AAAA",3,"USER") return end
			if expireTs<=os.time() then notificar("TAGDATA","A data já passou!",3,"USER") return end
			local playerAlvo=nil
			for _, p in pairs(Players:GetPlayers()) do
				if p.Name:lower()==nick:lower() or p.DisplayName:lower()==nick:lower() then playerAlvo=p break end
			end
			if not playerAlvo then notificar("TAGDATA","Player não encontrado no servidor!",3,"USER") return end
			local corTemp=configuracaoTags[tagSelecionada]
			enviarTag(playerAlvo.Name,tagSelecionada,corTemp,expireTs)
