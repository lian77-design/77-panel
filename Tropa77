			local charAlvo = jogadorAlvo.Character
			meuChar = player.Character
			meuRoot = meuChar and meuChar:FindFirstChild("HumanoidRootPart")
			meuHum = meuChar and meuChar:FindFirstChildOfClass("Humanoid")
