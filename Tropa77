	local function removerESP(p)
		local d = espDados[p.UserId]
		if not d then return end
		d.boxTop:Remove(); d.boxBot:Remove()
		d.boxLeft:Remove(); d.boxRight:Remove()
		d.label:Remove()
		espDados[p.UserId] = nil
	end
	
	local function esconderESP(p)
		local d = espDados[p.UserId]
		if not d then return end
		d.boxTop.Visible   = false
		d.boxBot.Visible   = false
		d.boxLeft.Visible  = false
		d.boxRight.Visible = false
		d.label.Visible    = false
	end
	
	local function limparTodosESP()
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= localPlayer then esconderESP(p) end
		end
	end
	
	-- ============================================================
	-- CALCULAR BOX 2D
	-- ============================================================
	local function calcularBox2D(char)
		local minX, minY =  math.huge,  math.huge
		local maxX, maxY = -math.huge, -math.huge
		local algumVisible = false
	
		for _, nome in ipairs(PARTES_NOME) do
			local part = char:FindFirstChild(nome)
			if part and part:IsA("BasePart") then
				local size = part.Size
				local cf   = part.CFrame
				local hx, hy, hz = size.X/2, size.Y/2, size.Z/2
				local corners = {
					cf:PointToWorldSpace(Vector3.new( hx,  hy,  hz)),
					cf:PointToWorldSpace(Vector3.new(-hx,  hy,  hz)),
					cf:PointToWorldSpace(Vector3.new( hx, -hy,  hz)),
					cf:PointToWorldSpace(Vector3.new(-hx, -hy,  hz)),
					cf:PointToWorldSpace(Vector3.new( hx,  hy, -hz)),
					cf:PointToWorldSpace(Vector3.new(-hx,  hy, -hz)),
					cf:PointToWorldSpace(Vector3.new( hx, -hy, -hz)),
					cf:PointToWorldSpace(Vector3.new(-hx, -hy, -hz)),
				}
				for _, wp in ipairs(corners) do
					local sp, onScreen = Camera:WorldToViewportPoint(wp)
					if onScreen then
						algumVisible = true
						if sp.X < minX then minX = sp.X end
						if sp.Y < minY then minY = sp.Y end
						if sp.X > maxX then maxX = sp.X end
						if sp.Y > maxY then maxY = sp.Y end
					end
				end
			end
		end
	
		if not algumVisible then return nil end
		return minX, minY, maxX, maxY
	end
	
	-- ============================================================
	-- ATUALIZAR ESP DE UM PLAYER
	-- ============================================================
	local function atualizarESP(p, localRoot)
		local d = espDados[p.UserId]
		if not d then return end
	
		-- Throttle
		d.tick = d.tick + 1
		if d.tick < SKIP_TICKS then return end
		d.tick = 0
	
		local char = p.Character
		if not char then esconderESP(p) return end
	
		local root     = char:FindFirstChild("HumanoidRootPart")
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid or humanoid.Health <= 0 then
			esconderESP(p) return
		end
	
		-- ─── FILTRO DE DISTÂNCIA (100 studs) ───────────────────
		if localRoot then
			local dist = (root.Position - localRoot.Position).Magnitude
			if dist > DISTANCIA_MAX then
				esconderESP(p) return
			end
		end
	
		-- ─── CHECA SE ESTÁ NA TELA ─────────────────────────────
		local _, onScreen = Camera:WorldToViewportPoint(root.Position)
		if not onScreen then esconderESP(p) return end
	
		-- ─── BOX 2D ────────────────────────────────────────────
		local minX, minY, maxX, maxY = calcularBox2D(char)
		if not minX then esconderESP(p) return end
	
		local pad = 3
		minX = minX - pad; minY = minY - pad
		maxX = maxX + pad; maxY = maxY + pad
	
		-- Drawing Line usa From/To com Vector2
		-- Topo
		d.boxTop.From    = Vector2.new(minX, minY)
		d.boxTop.To      = Vector2.new(maxX, minY)
		d.boxTop.Visible = true
		-- Base
		d.boxBot.From    = Vector2.new(minX, maxY)
		d.boxBot.To      = Vector2.new(maxX, maxY)
		d.boxBot.Visible = true
		-- Esquerda
		d.boxLeft.From    = Vector2.new(minX, minY)
		d.boxLeft.To      = Vector2.new(minX, maxY)
		d.boxLeft.Visible = true
		-- Direita
		d.boxRight.From    = Vector2.new(maxX, minY)
		d.boxRight.To      = Vector2.new(maxX, maxY)
		d.boxRight.Visible = true
	
		-- ─── NOME + DISTÂNCIA ──────────────────────────────────
		local dist = localRoot
			and math.floor((root.Position - localRoot.Position).Magnitude)
			or 0
	
		d.label.Text     = p.DisplayName .. "  [" .. dist .. "m]"
		d.label.Position = Vector2.new(minX, minY - 17)
		d.label.Visible  = true
	end
	
	-- ============================================================
	-- LOOP PRINCIPAL
	-- ============================================================
	local conexaoESP = nil
	
	local function iniciarLoopESP()
		if conexaoESP then return end
		conexaoESP = RunService.Heartbeat:Connect(function()
			if not espAtivo then return end
	
			local localRoot = localPlayer.Character
				and localPlayer.Character:FindFirstChild("HumanoidRootPart")
	
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= localPlayer then
					if not espDados[p.UserId] then criarESP(p) end
					atualizarESP(p, localRoot)
				end
			end
		end)
	end
	
	iniciarLoopESP()
	
	-- ============================================================
	-- TOGGLE ESP  (liga/desliga o ESP em si)
	-- ============================================================
	local function toggleESP()
		-- ⚠️ SÓ FUNCIONA SE O BOTÃO ESTIVER ATIVO
		if not botaoAtivo then return end
	
		espAtivo = not espAtivo
	
		if espAtivo then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= localPlayer then criarESP(p) end
			end
			if iconeStatus then iconeStatus.TextColor3 = Color3.fromRGB(0, 255, 0) end
			notificar("ESP ATIVADO", "Pressione [E] para desativar | Range: " .. DISTANCIA_MAX .. " studs", Color3.fromRGB(120, 0, 0))
		else
			limparTodosESP()
			if iconeStatus then iconeStatus.TextColor3 = Color3.fromRGB(255, 0, 0) end
			notificar("ESP DESATIVADO", "Pressione [E] para ativar", Color3.fromRGB(60, 60, 60))
		end
	end
	
	-- ============================================================
	-- BOTÃO — controla se o sistema está disponível
	-- ============================================================
	botao.MouseButton1Click:Connect(function()
		botaoAtivo = not botaoAtivo
	
		if not botaoAtivo then
			-- Desativa tudo ao desligar o botão
			if espAtivo then
				espAtivo = false
				limparTodosESP()
			end
			if iconeStatus then iconeStatus.TextColor3 = Color3.fromRGB(255, 0, 0) end
			notificar("ESP DESATIVADO", "Botão desligado", Color3.fromRGB(60, 60, 60))
		else
			notificar("ESP PRONTO", "Pressione [E] para ativar o ESP", Color3.fromRGB(180, 100, 0))
		end
	end)
	
	-- ============================================================
	-- TECLA [E] — só funciona se botaoAtivo = true
	-- ============================================================
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == Enum.KeyCode.E then
			toggleESP()
		end
	end)
	
	-- ============================================================
	-- PLAYERS ENTRANDO / SAINDO / RESPAWN
	-- ============================================================
	Players.PlayerAdded:Connect(function(p)
		if espAtivo then criarESP(p) end
	end)
	
	Players.PlayerRemoving:Connect(function(p)
		removerESP(p)
	end)
	
	localPlayer.CharacterAdded:Connect(function()
		task.wait(0.5)
		if espAtivo then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= localPlayer then
					removerESP(p)
					criarESP(p)
				end
			end
		end
	end)
end;
