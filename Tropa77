local function C_10d()
local script = G2L["10d"];
	local Button = script.Parent
	local Indicator = Button:FindFirstChild("TextLabel")
	local plr = game:GetService("Players").LocalPlayer
	local UIS = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	
	local airwalkOn = false
	local connection = nil
	local mobileGui = nil
	
	-- Variáveis de controle para os botões mobile
	local subindoMobile = false
	local descendoMobile = false
	
	-- =============================================
	-- FUNÇÃO PARA CRIAR BOTÕES NA TELA DO MOBILE
	-- =============================================
	local function criarBotoesMobile()
		if mobileGui then mobileGui:Destroy() end
	
		local playerGui = plr:WaitForChild("PlayerGui")
	
		mobileGui = Instance.new("ScreenGui")
		mobileGui.Name = "AirwalkMobileControls"
		mobileGui.ResetOnSpawn = false
		mobileGui.DisplayOrder = 100
		mobileGui.Parent = playerGui
	
		-- Botão SUBIR (⬆️)
		local btnUp = Instance.new("TextButton")
		btnUp.Name = "BtnUp"
		btnUp.Size = UDim2.new(0, 60, 0, 60)
		btnUp.Position = UDim2.new(0.85, 0, 0.45, 0)
		btnUp.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		btnUp.BackgroundTransparency = 0.3
		btnUp.Text = "⬆️"
		btnUp.TextSize = 26
		btnUp.TextColor3 = Color3.fromRGB(255, 255, 255)
		btnUp.Parent = mobileGui
	
		local cornerUp = Instance.new("UICorner")
		cornerUp.CornerRadius = UDim.new(0, 12)
		cornerUp.Parent = btnUp
	
		-- Botão DESCER (⬇️)
		local btnDown = Instance.new("TextButton")
		btnDown.Name = "BtnDown"
		btnDown.Size = UDim2.new(0, 60, 0, 60)
		btnDown.Position = UDim2.new(0.85, 0, 0.60, 0)
		btnDown.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		btnDown.BackgroundTransparency = 0.3
		btnDown.Text = "⬇️"
		btnDown.TextSize = 26
		btnDown.TextColor3 = Color3.fromRGB(255, 255, 255)
		btnDown.Parent = mobileGui
	
		local cornerDown = Instance.new("UICorner")
		cornerDown.CornerRadius = UDim.new(0, 12)
		cornerDown.Parent = btnDown
	
		-- DETECÇÃO DE TOQUE PERFEITA PARA MOBILE
		btnUp.MouseButton1Down:Connect(function() subindoMobile = true end)
		btnUp.MouseButton1Up:Connect(function() subindoMobile = false end)
		btnUp.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				subindoMobile = false
			end
		end)
	
		btnDown.MouseButton1Down:Connect(function() descendoMobile = true end)
		btnDown.MouseButton1Up:Connect(function() descendoMobile = false end)
		btnDown.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				descendoMobile = false
			end
		end)
	end
	
	-- =============================================
	-- FUNÇÃO PARA REMOVER BOTÕES MOBILE
	-- =============================================
	local function removerBotoesMobile()
		subindoMobile = false
		descendoMobile = false
		if mobileGui then
			mobileGui:Destroy()
			mobileGui = nil
		end
	end
	
	-- =============================================
	-- ATIVAÇÃO E DESATIVAÇÃO DO AIRWALK
	-- =============================================
	Button.MouseButton1Click:Connect(function()
		local char = plr.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum then return end
	
		if not airwalkOn then
			airwalkOn = true
			if Indicator then Indicator.TextColor3 = Color3.fromRGB(0, 255, 0) end
	
			-- Cria plataforma invisível
			local fakePart = Instance.new("Part", workspace)
			fakePart.Name = "AirwalkFloor"
			fakePart.Anchored = true
			fakePart.CanCollide = true
			fakePart.Transparency = 1
			fakePart.Size = Vector3.new(50, 1, 50)
			fakePart.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - (hum.HipHeight + 1.5), hrp.Position.Z)
	
			local targetY = fakePart.Position.Y
	
			-- Sempre cria os botões se for tela de toque ou emulador
			if UIS.TouchEnabled then
				criarBotoesMobile()
			end
	
			-- Loop principal de movimentação
			connection = RunService.Heartbeat:Connect(function()
				if not airwalkOn then return end
	
				-- Subir (Espaço no PC ou Botão ⬆️ segurado no Mobile)
				if UIS:IsKeyDown(Enum.KeyCode.Space) or subindoMobile then
					targetY = targetY + 0.3
				end
	
				-- Descer (Control / Shift no PC ou Botão ⬇️ segurado no Mobile)
				if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) or descendoMobile then
					targetY = targetY - 0.3
				end
	
				-- Atualiza a posição da plataforma
				if workspace:FindFirstChild("AirwalkFloor") then
					workspace.AirwalkFloor.CFrame = CFrame.new(hrp.Position.X, targetY, hrp.Position.Z)
				end
			end)
	
		else
			airwalkOn = false
			if Indicator then Indicator.TextColor3 = Color3.fromRGB(255, 0, 0) end
	
			if connection then
				connection:Disconnect()
				connection = nil
			end
	
			if workspace:FindFirstChild("AirwalkFloor") then
				workspace.AirwalkFloor:Destroy()
			end
	
			removerBotoesMobile()
		end
	end)
	
	-- Limpeza de segurança caso o jogador renasça
	plr.CharacterAdded:Connect(function()
		airwalkOn = false
		if Indicator then Indicator.TextColor3 = Color3.fromRGB(255, 0, 0) end
		if connection then connection:Disconnect() connection = nil end
		if workspace:FindFirstChild("AirwalkFloor") then workspace.AirwalkFloor:Destroy() end
		removerBotoesMobile()
	end)
end;
