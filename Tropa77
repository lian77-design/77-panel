	local function tempoParaSegundos(str)
		str=str:lower():gsub("%s","")
		local h=str:match("^(%d+)h$")
		local m=str:match("^(%d+)m$")
		if h then return tonumber(h)*3600 end
		if m then return tonumber(m)*60 end
		return nil
	end
	
	local function formatarTempo(s)
		return s>=3600 and math.floor(s/3600).."h" or math.floor(s/60).."min"
	end
	
	if taghoraBtn then
		taghoraBtn.MouseButton1Click:Connect(function()
			if tagSelecionada=="" then notificar("TAGHORA","Selecione uma tag primeiro!",3,"USER") return end
			local nick=taghoraInput and taghoraInput.Text or ""
			nick=nick:gsub("^%s*(.-)%s*$","%1")
			if nick=="" then notificar("TAGHORA","Digite o nick do player!",3,"USER") return end
			local tempoStr=taghoraTime and taghoraTime.Text or ""
			tempoStr=tempoStr:gsub("^%s*(.-)%s*$","%1")
			local segundos=tempoParaSegundos(tempoStr)
			if not segundos or segundos<=0 then notificar("TAGHORA","Tempo inválido! Use: 30m ou 2h",3,"USER") return end
			if segundos>72*3600 then notificar("TAGHORA","Máximo: 72h por vez!",3,"USER") return end
			local playerAlvo=nil
			for _, p in pairs(Players:GetPlayers()) do
				if p.Name:lower()==nick:lower() or p.DisplayName:lower()==nick:lower() then playerAlvo=p break end
			end
			if not playerAlvo then notificar("TAGHORA","Player não encontrado no servidor!",3,"USER") return end
			local corTemp=configuracaoTags[tagSelecionada]
			local tf=formatarTempo(segundos)
			local expireTs=os.time()+segundos
			enviarTag(playerAlvo.Name,tagSelecionada,corTemp,expireTs)
			aplicarTagVisual(playerAlvo,tagSelecionada,corTemp)
			if playerAlvo==localPlayer then atualizarAbas(tagSelecionada) end
			notificar("TAGHORA",playerAlvo.DisplayName.." → "..tagSelecionada.." por "..tf,5,tagSelecionada)
			logDiscord("TAGHORA", localPlayer.Name, playerAlvo.Name, tagSelecionada, nil, nil, tf)
			if taghoraInput then taghoraInput.Text="" end
			if taghoraTime then taghoraTime.Text="" end
			task.spawn(function()
				task.wait(segundos)
				local corUser=configuracaoTags["USER"]
				enviarTag(playerAlvo.Name,"USER",corUser)
				for _, p in pairs(Players:GetPlayers()) do
					if p.Name==playerAlvo.Name then
						aplicarTagVisual(p,"USER",corUser)
						if p==localPlayer then atualizarAbas("USER") end
						notificar("TAGHORA",p.DisplayName.." voltou para USER ("..tf.." expirou)",5,"USER")
						break
					end
				end
			end)
		end)
	end
	
