	local function corParaTabela(cor)
		return {
			math.floor(cor.R * 255 + 0.5),
			math.floor(cor.G * 255 + 0.5),
			math.floor(cor.B * 255 + 0.5)
		}
	end
	
	local function tabelaParaCor(t)
		if type(t) ~= "table" then return Color3.fromRGB(255,255,255) end
		if t[1] ~= nil then
			return Color3.fromRGB(
				math.clamp(math.floor(tonumber(t[1]) or 255), 0, 255),
				math.clamp(math.floor(tonumber(t[2]) or 255), 0, 255),
				math.clamp(math.floor(tonumber(t[3]) or 255), 0, 255)
			)
		end
		if t.r ~= nil or t.R ~= nil then
			local r = tonumber(t.r or t.R) or 255
			local g = tonumber(t.g or t.G) or 255
			local b = tonumber(t.b or t.B) or 255
			if r <= 1 and g <= 1 and b <= 1 then
				r, g, b = r*255, g*255, b*255
			end
			return Color3.fromRGB(
				math.clamp(math.floor(r), 0, 255),
				math.clamp(math.floor(g), 0, 255),
				math.clamp(math.floor(b), 0, 255)
			)
		end
		return Color3.fromRGB(255,255,255)
	end
	
	local function enviarTag(playerName, cargo, cor, expireTs, permissao, efeito)
		if meuCargo ~= "OWNER" then return false end
		pcall(function()
			local body = {
				player  = playerName,
				cargo   = cargo,
				cor     = corParaTabela(cor),
				gameId  = GAME_ID,
			}
			if expireTs  then body.expireTs  = expireTs  end
			if permissao then body.permissao = permissao end
			if efeito and efeito ~= "" then body.efeito = efeito end
			httpRequest({
				Url=SERVIDOR.."/settag", Method="POST",
				Headers={["Content-Type"]="application/json"},
				Body=HttpService:JSONEncode(body)
			})
		end)
	end
	
