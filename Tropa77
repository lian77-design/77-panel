		staffScroll.ScrollingEnabled      = true
		staffScroll.ClipsDescendants      = true
		staffScroll.ScrollBarThickness    = 5
		staffScroll.ScrollBarImageColor3  = Color3.fromRGB(180, 30, 30)
		staffScroll.CanvasSize            = UDim2.new(0, 0, 0, 0)
		staffScroll.ScrollingDirection    = Enum.ScrollingDirection.Y
		local le = staffScroll:FindFirstChildOfClass("UIListLayout")
		if le then le:Destroy() end
		local spOld = staffScroll:FindFirstChildOfClass("UIPadding")
		if spOld then spOld:Destroy() end
