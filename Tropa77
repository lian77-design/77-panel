-- StarterGui.ScreenGui.MainPanel.MiscTela4.FLASHBACK.LocalScript
local function C_9c()
local script = G2L["9c"];
	--[[
		Flashback v4
		- Velocidade proporcional ao tempo real (sem acelerar)
		- Ao soltar V, personagem continua de onde está (não pula pro início)
		- Toque rápido em V = pulo suave de volta (volta ~0.4s)
		- Pernas andam pra trás via Speed negativo no Animator
	]]
	
	local RunService       = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local Players          = game:GetService("Players")
	
	local player      = Players.LocalPlayer
	local botao       = script.Parent
	local iconeStatus = botao:WaitForChild("TextLabel")
	
	------------------------------------------------------------------------
	-- CONFIG
	------------------------------------------------------------------------
	local DURACAO_MAX    = 12      -- segundos de histórico guardado
	local FPS_GRAV       = 60      -- frames por segundo de gravação
	local INTERVALO_GRAV = 1 / FPS_GRAV
	
	-- Velocidade de rebobinamento: 1.0 = igual ao tempo real, 0.5 = metade
	local VEL_REBOB = 1.0
	
	-- Suavidade da posição (lerp): 8 = fluido, 20 = rígido
	local SUAVIDADE = 8
	
	-- Quantos segundos volta num toque rápido de V (< 0.15s pressionado)
	local TOQUE_RAPIDO_DURACAO = 0.4
	------------------------------------------------------------------------
	
	local MAX_FRAMES = math.floor(DURACAO_MAX * FPS_GRAV)
	
	local ativo       = false
	local frames      = {}        -- buffer circular, [1] = mais recente
	local tempoGrav   = 0
	
	-- Estado do rebobinamento
	local rebobAtivo   = false
	local indiceFlt    = 1.0      -- posição atual no buffer (float)
	local tempoPressV  = 0        -- quanto tempo V ficou pressionado
	
	-- Animações controladas
	local tracksInvertidas = {}
	
	------------------------------------------------------------------------
	-- Helpers de animação
	------------------------------------------------------------------------
	local function getAnimator(char)
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then return nil end
		return hum:FindFirstChildOfClass("Animator")
	end
	
	local function inverterAnimacoes(char)
		local animator = getAnimator(char)
		if not animator then return end
		table.clear(tracksInvertidas)
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			if track.Speed > 0 then
				tracksInvertidas[track] = track.Speed
				track.Speed = -track.Speed * VEL_REBOB
			end
		end
	end
	
	local function restaurarAnimacoes()
		for track, spd in pairs(tracksInvertidas) do
			pcall(function() track.Speed = spd end)
		end
		table.clear(tracksInvertidas)
	end
	
	local function sincronizarTimePos(char, snap)
		local animator = getAnimator(char)
		if not animator or not snap then return end
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			local info = snap[track.Animation.AnimationId]
			if info then
				pcall(function() track.TimePosition = info.timePos end)
			end
		end
	end
	
	local function capturarAnimacoes(char)
		local animator = getAnimator(char)
		if not animator then return {} end
		local snap = {}
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			snap[track.Animation.AnimationId] = {
				timePos = track.TimePosition,
				speed   = track.Speed,
			}
		end
		return snap
	end
	
	------------------------------------------------------------------------
	-- Gravar 1 frame
	------------------------------------------------------------------------
	local function gravarFrame(root, hum, char)
		table.insert(frames, 1, {
			cf        = root.CFrame,
			state     = hum:GetState(),
			animTimes = capturarAnimacoes(char),
			tool      = char:FindFirstChildOfClass("Tool"),
		})
		if #frames > MAX_FRAMES then
			table.remove(frames)
		end
	end
	
	------------------------------------------------------------------------
	-- Liga / Desliga painel
	------------------------------------------------------------------------
	botao.MouseButton1Click:Connect(function()
		ativo = not ativo
		if ativo then
			iconeStatus.TextColor3 = Color3.fromRGB(0, 255, 0)
		else
			iconeStatus.TextColor3 = Color3.fromRGB(255, 0, 0)
			restaurarAnimacoes()
			table.clear(frames)
			indiceFlt   = 1.0
			rebobAtivo  = false
			tempoPressV = 0
		end
	end)
	
	------------------------------------------------------------------------
	-- Loop principal
	------------------------------------------------------------------------
	local vPressionado  = false   -- estado anterior da tecla
	
	RunService.Heartbeat:Connect(function(dt)
		if not ativo then return end
	
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum  = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not hum then return end
	
		local vAgora = UserInputService:IsKeyDown(Enum.KeyCode.V)
	
		-- ── Detecta início do pressionamento de V ─────────────────────────────
		if vAgora and not vPressionado then
			-- Começa a contar quanto tempo V fica pressionado
			tempoPressV = 0
			-- Inicia rebobinamento
			rebobAtivo = true
			-- Sincroniza TimePosition das animações com frame [1]
			sincronizarTimePos(char, frames[1] and frames[1].animTimes)
			-- Inverte speed das animações (pernas pra trás)
			inverterAnimacoes(char)
		end
	
		-- ── Detecta soltura de V ──────────────────────────────────────────────
		if not vAgora and vPressionado then
			-- Restaura animações normais
			restaurarAnimacoes()
	
			-- Se foi toque rápido, ativa modo "pulo suave":
			-- rebobAtivo permanece true mas vai parar sozinho depois de TOQUE_RAPIDO_DURACAO
			if tempoPressV < 0.15 then
				-- não faz nada aqui, o rebobAtivo já vai parar pelo tempoPressV
			else
				-- Soltura longa: para rebob imediatamente
				rebobAtivo = false
			end
		end
	
		vPressionado = vAgora
	
		-- ── MODO REBOBINAR ────────────────────────────────────────────────────
		if rebobAtivo then
			tempoPressV = tempoPressV + dt
	
			-- Toque rápido: para automaticamente após TOQUE_RAPIDO_DURACAO segundos
			if not vAgora and tempoPressV >= TOQUE_RAPIDO_DURACAO then
				rebobAtivo = false
				restaurarAnimacoes()
				-- (indiceFlt fica onde está, próxima gravação continua daqui)
				return
			end
	
			if #frames < 2 then return end
	
			-- Avança ponteiro proporcionalmente ao tempo real
			-- dt / INTERVALO_GRAV = quantos frames gravaríamos nesse dt
			-- VEL_REBOB controla quão rápido rebobina em relação ao tempo real
			indiceFlt = indiceFlt + VEL_REBOB * (dt / INTERVALO_GRAV)
			indiceFlt = math.min(indiceFlt, #frames - 1)
	
			local i     = math.floor(indiceFlt)
			local alpha = indiceFlt - i
	
			local fA = frames[i]
			local fB = frames[i + 1]
			if not fA or not fB then return end
	
			-- Lerp suave (frame-rate independent, exponencial)
			local fator  = 1 - math.exp(-SUAVIDADE * dt)
			local cfAlvo = fA.cf:Lerp(fB.cf, alpha)
			root.CFrame  = root.CFrame:Lerp(cfAlvo, fator)
	
			-- Para não escorregar
			root.AssemblyLinearVelocity  = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
	
			-- Ferramenta
			if fA.tool and not char:FindFirstChildOfClass("Tool") then
				hum:EquipTool(fA.tool)
			elseif not fA.tool and char:FindFirstChildOfClass("Tool") then
				hum:UnequipTools()
			end
	
			-- ── MODO GRAVAÇÃO ─────────────────────────────────────────────────────
		else
			-- Quando solta V, joga o indiceFlt de volta pra 1
			-- (próxima gravação começa do ponto atual, não do início do buffer)
			if indiceFlt > 1.0 then
				-- Corta fora os frames "no passado" que já rebobinamos
				-- para o buffer refletir o estado atual do personagem
				local pos = math.floor(indiceFlt)
				if pos >= 2 then
					for j = pos, #frames do
						frames[j] = nil
					end
				end
				indiceFlt = 1.0
			end
	
			tempoGrav = tempoGrav + dt
			if tempoGrav >= INTERVALO_GRAV then
				tempoGrav = 0
				gravarFrame(root, hum, char)
			end
		end
	end)
end;
