-- StarterGui.ScreenGui.MainPanel.HomeTela1.DATA.LocalScript
local function C_90()
local script = G2L["90"];
	local label = script.Parent
	local ultimoMinuto = -1
	
	while true do
		-- 1. Pega o tempo atual em segundos
		local tempoAtual = os.time()
	
		-- 2. Ajustes: 
		-- Subtrai 10800 segundos (3 horas) para Brasília
		-- Soma 120 segundos (2 minutos) para a sua correção manual
		local tempoCorrigido = tempoAtual - 10800 + 120
	
		-- 3. Converte para tabela de data (usando "!" para garantir que baseie no UTC)
		local d = os.date("!*t", tempoCorrigido)
	
		-- 4. Só atualiza o texto se o minuto mudar (evita piscar)
		if d.min ~= ultimoMinuto then
			ultimoMinuto = d.min
			label.Text = string.format(
				"%02d/%02d/%04d - %02d:%02d",
				d.day, d.month, d.year, d.hour, d.min
			)
		end
	
		task.wait(1)
