		end
	
		if btnOwner     then btnOwner.Visible     = ehDono or (tagsOwnerAcesso[cargoEfetivo] == true) end
		if btnStaff     then btnStaff.Visible     = ehDono or (tagsStaffAcesso[cargoEfetivo] == true) end
		if btnBan       then btnBan.Visible       = ehDono or (tagsBanAcesso[cargoEfetivo]   == true) end
		if btnVip       then btnVip.Visible       = true end
		if btnCreateTag then btnCreateTag.Visible = ehDono or (tagsCreateTagAcess[cargoEfetivo] == true) end
		-- [[ v4.4 ]] Animation visível para TODOS, sempre
		if btnAnimation then btnAnimation.Visible = true end
	
		if telaAtual==ownerTela     and btnOwner     and not btnOwner.Visible     then abrirTela(homeTela) end
		if telaAtual==staffTela     and btnStaff     and not btnStaff.Visible     then abrirTela(homeTela) end
		if telaAtual==banTela       and btnBan       and not btnBan.Visible       then abrirTela(homeTela) end
