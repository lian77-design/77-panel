		local function pararPreviewEfeito()
			if previewThreadAtivo then
				task.cancel(previewThreadAtivo)
				previewThreadAtivo = nil
			end
			if previewGradAtivo and previewGradAtivo.Parent then
				previewGradAtivo:Destroy()
				previewGradAtivo = nil
			end
			if ctTagPreview then
				pcall(function() ctTagPreview.TextColor3 = ctCorAtual end)
				pcall(function() ctTagPreview.TextStrokeTransparency = 0.4 end)
			end
		end
	
		local function aplicarPreviewEfeito(efeitoNome)
			pararPreviewEfeito()
			if not ctTagPreview then return end
	
			if efeitoNome == "Gold Shine" then
				local grad = Instance.new("UIGradient", ctTagPreview)
				previewGradAtivo = grad
				local c1 = Color3.fromRGB(255, 215, 0)
				grad.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0,    c1),
					ColorSequenceKeypoint.new(0.30, c1),
					ColorSequenceKeypoint.new(0.45, Color3.fromRGB(255,255,255)),
					ColorSequenceKeypoint.new(0.55, Color3.fromRGB(255,255,255)),
					ColorSequenceKeypoint.new(0.70, c1),
					ColorSequenceKeypoint.new(1,    c1),
				})
				previewThreadAtivo = task.spawn(function()
					while ctTagPreview and ctTagPreview.Parent do
						grad.Offset = Vector2.new(-1.5, 0)
						TweenService:Create(grad, TweenInfo.new(3.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Offset=Vector2.new(1.5,0)}):Play()
						task.wait(3.8)
					end
				end)
	
			elseif efeitoNome == "Glow Wave" then
				ctTagPreview.TextColor3 = ctCorAtual
				previewThreadAtivo = task.spawn(function()
					while ctTagPreview and ctTagPreview.Parent do
						TweenService:Create(ctTagPreview, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextStrokeTransparency=0.0}):Play()
						task.wait(0.8)
						TweenService:Create(ctTagPreview, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextStrokeTransparency=0.8}):Play()
						task.wait(0.8)
					end
				end)
	
			elseif efeitoNome == "Rainbow Flow" then
				local grad = Instance.new("UIGradient", ctTagPreview)
				previewGradAtivo = grad
				local rainbowColors = {
					Color3.fromRGB(255,0,0), Color3.fromRGB(255,165,0),
					Color3.fromRGB(255,255,0), Color3.fromRGB(0,255,0),
					Color3.fromRGB(0,0,255), Color3.fromRGB(128,0,128),
				}
				local kps = {}
				for i2, c2 in ipairs(rainbowColors) do
					table.insert(kps, ColorSequenceKeypoint.new((i2-1)/(#rainbowColors-1), c2))
				end
				grad.Color = ColorSequence.new(kps)
				previewThreadAtivo = task.spawn(function()
					local t = 0
					while ctTagPreview and ctTagPreview.Parent do
						t = t + 0.02
						grad.Offset = Vector2.new(math.sin(t)*1.5, 0)
						task.wait(0.05)
					end
				end)
	
			elseif efeitoNome == "Neon Pulse" then
				previewThreadAtivo = task.spawn(function()
					while ctTagPreview and ctTagPreview.Parent do
						TweenService:Create(ctTagPreview, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {TextColor3=Color3.fromRGB(255,255,255)}):Play()
						task.wait(0.4)
						TweenService:Create(ctTagPreview, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {TextColor3=ctCorAtual}):Play()
						task.wait(0.4)
					end
				end)
			end
		end
	
		local function atualizarPreview()
			if not ctTagPreview then return end
			local texto = ctNomeDaTag and ctNomeDaTag.Text or ""
			texto = texto:gsub("^%s*(.-)%s*$", "%1")
			ctTagPreview.Text = texto ~= "" and texto or "TAG"
			ctTagPreview.Visible = true
			if ctEfeitoSel == "" or ctEfeitoSel == "Glow Wave" or ctEfeitoSel == "Neon Pulse" then
				ctTagPreview.TextColor3 = ctCorAtual
			end
			if ctEfeitoSel ~= "" then
				aplicarPreviewEfeito(ctEfeitoSel)
			end
		end
	
		if ctNomeDaTag then
			ctNomeDaTag:GetPropertyChangedSignal("Text"):Connect(atualizarPreview)
		end
	
		if ctNomeJog then
			ctNomeJog:GetPropertyChangedSignal("Text"):Connect(function()
				local d = ctNomeJog.Text:lower()
				ctPlayerAlvo = nil
				if d == "" then
					if ctImagem    then ctImagem.Image = IMAGEM_PADRAO end
					if ctDisplayLbl then ctDisplayLbl.Text = "display name" end
					if ctIdLbl     then ctIdLbl.Text = "id do jogador" end
					return
				end
				for _, p in pairs(Players:GetPlayers()) do
					if p.Name:lower():find(d,1,true) or p.DisplayName:lower():find(d,1,true) then
						ctPlayerAlvo = p
						if ctDisplayLbl then ctDisplayLbl.Text = p.DisplayName end
						if ctIdLbl      then ctIdLbl.Text = "ID: "..p.UserId end
						local ok, img = pcall(function()
							return Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
						end)
						if ctImagem then ctImagem.Image = ok and img or IMAGEM_PADRAO end
