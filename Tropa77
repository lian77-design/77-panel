			notificar("TAGDATA",playerAlvo.DisplayName.." → "..tagSelecionada.." até "..dataStr,5,tagSelecionada)
			logDiscord("TAGDATA", localPlayer.Name, playerAlvo.Name, tagSelecionada, nil, nil, dataStr)
