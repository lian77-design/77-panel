			avatarImg.ScaleType          = Enum.ScaleType.Crop
			Instance.new("UICorner", avatarImg).CornerRadius = UDim.new(0, 7)
			task.spawn(function()
				local ok, img = pcall(function()
					return Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size60x60)
				end)
				if ok and avatarImg and avatarImg.Parent then avatarImg.Image = img end
