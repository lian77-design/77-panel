	local function atualizarListaStaff()
		if not staffScroll then return end
	
		for _, b in pairs(botoesStaff) do
			if b and b.Parent then b:Destroy() end
		end
		botoesStaff = {}
	
		local offsetInicial = 0
		if btnTeleportStaff then
			btnTeleportStaff.Size     = UDim2.new(1, 0, 0, 36)
			btnTeleportStaff.Position = UDim2.new(0, 0, 0, 0)
			offsetInicial             = 36 + CARD_GAP + 4
		end
	
		local playersValidos = {}
		for userId, info in pairs(playersComPainel) do
			for _, pl in pairs(Players:GetPlayers()) do
				if pl.UserId == userId then
					table.insert(playersValidos, {player = pl, info = info})
					break
				end
			end
		end
	
		local ordemCargo = {
			OWNER=1, MANAGER=2, DEVELOP=3, MEOW=4,
			STAFF=5, SUPORTE=6, ["VIP 4E20"]=7, BABY=8, USER=9
		}
		table.sort(playersValidos, function(a, b)
			local oa = ordemCargo[a.info.cargo or "USER"] or 9
			local ob = ordemCargo[b.info.cargo or "USER"] or 9
			return oa < ob
		end)
	
		local i = 0
