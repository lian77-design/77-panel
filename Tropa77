local function C_111()
local script = G2L["111"];
	print("[4e20] Modo Smooth Auto-Lock (Câmera Lisa) Ativado!")
	
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local LocalPlayer = Players.LocalPlayer
	local Camera = workspace.CurrentCamera
	
	local Botao = script.Parent
	local Sinalizador = Botao and Botao:FindFirstChildOfClass("TextLabel") 
	
	-- Configurações de Detecção e Suavidade
	local LIMITE_PIXELS_TELA = 350 -- Raio na tela para puxar o alvo automaticamente
	local sistemaAtivo = false 
	local conexaoRender = nil 
	
	local COR_ATIVO = Color3.fromRGB(0, 255, 0)     
	local COR_DESATIVO = Color3.fromRGB(255, 0, 0)  
	
	-- Função que localiza o inimigo mais próximo do centro da tela de forma leve
	local function obterAlvoMaisProximoDaTela()
		local menorDistanciaTela = LIMITE_PIXELS_TELA
		local parteAlvo = nil
	
		local meuCharacter = LocalPlayer.Character
		local centroTela = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	
		for _, jogador in pairs(Players:GetPlayers()) do
			if jogador ~= LocalPlayer then
				local char = jogador.Character or workspace:FindFirstChild(jogador.Name)
	
				if char then
					-- Foca no "UpperTorso" ou "HumanoidRootPart" (peito) para o scope da AWP não tremer
					local rootPart = char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
					local humanoid = char:FindFirstChildOfClass("Humanoid")
	
					if rootPart and (not humanoid or humanoid.Health > 0) then
						local posicaoTela, naTela = Camera:WorldToViewportPoint(rootPart.Position)
	
						if naTela then
							local distanciaTela = (centroTela - Vector2.new(posicaoTela.X, posicaoTela.Y)).Magnitude
							if distanciaTela < menorDistanciaTela then
								menorDistanciaTela = distanciaTela
								partAlvo = rootPart
							end
						end
					end
				end
			end
		end
	
		return parteAlvo
	end
	
	-- Gerenciador do estado do Aimbot (Liga / Desliga)
	local function alternarEstadoAimbot(estado)
		sistemaAtivo = estado
	
		if sistemaAtivo then
			if Sinalizador then Sinalizador.TextColor3 = COR_ATIVO end
			print("[4e20] AIMBOT LISO LIGADO!")
	
			-- Usamos o loop RenderStepped para alinhar perfeitamente com a taxa de atualização do seu monitor
			conexaoRender = RunService.RenderStepped:Connect(function()
				if sistemaAtivo then
					local alvoAtual = obterAlvoMaisProximoDaTela()
	
					if alvoAtual then
						-- MANTÉM A CÂMERA EM CUSTOM (Sua câmera NUNCA mais vai travar ou congelar)
						Camera.CameraType = Enum.CameraType.Custom
	
						-- Ajusta apenas a rotação da câmera olhando diretamente para a posição do inimigo
						local posicaoCamera = Camera.CFrame.Position
						Camera.CFrame = CFrame.lookAt(posicaoCamera, alvoAtual.Position)
					end
				end
			end)
		else
			if Sinalizador then Sinalizador.TextColor3 = COR_DESATIVO end
			print("[4e20] AIMBOT DESLIGADO!")
	
			if conexaoRender then
				conexaoRender:Disconnect()
				conexaoRender = nil
			end
			Camera.CameraType = Enum.CameraType.Custom
		end
	end
	
	-- Ativa/Desativa pressionando a Tecla X
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.X then
			alternarEstadoAimbot(not sistemaAtivo)
		end
	end)
	
	-- Permite ativar clicando no botão do painel
	if Botao and Botao:IsA("GuiButton") then
		Botao.MouseButton1Click:Connect(function()
			alternarEstadoAimbot(not sistemaAtivo)
		end)
	end
end;
