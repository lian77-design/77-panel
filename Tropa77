	local function atualizarAbas(cargo)
		meuCargo = cargo
		local ehDono = cargoEfetivo == "OWNER"
	
		local cargoEfetivo = cargo
		local tagPers = tagsPersonalizadas[localPlayer.Name]
	
		if tagPers and tagPers.permissao
			and tagPers.permissao ~= ""
			and tagPers.permissao ~= "null"
			and tagPers.permissao ~= nil then
			cargoEfetivo = cargoEfetivoPorPermissao(tagPers.permissao)
		elseif configuracaoTags[cargo] then
