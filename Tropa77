-- StarterGui.ScreenGui.MainPanel.CharacterTela5.FLY.LocalScript
local function C_73()
local script = G2L["73"];
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")
	local CoreGui = game:GetService("CoreGui")
	
	local player = Players.LocalPlayer
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid")
	local rootPart = character:WaitForChild("HumanoidRootPart")
	
	-- Botão principal do painel e ícone (+)
	local mainFlyButton = script.Parent
	local statusIcon = mainFlyButton:WaitForChild("TextLabel")
	
	-- Estados do sistema
	local systemEnabled = false -- Controla se o recurso FLY está ligado no painel (+)
	local isFlying = false      -- Controla se o personagem está VOANDO agora no jogo
	
	local speed = 90
	local lastToggle = 0
	
	local bodyVelocity
	local bodyGyro
	local FLY_VELOCITY_NAME = "FlyBodyVelocity"
	local FLY_GYRO_NAME = "FlyBodyGyro"
	
	-- Identifica se é Mobile
	local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	
	local btnInput = { W = false, A = false, S = false, D = false }
	local mobileGui = nil
	
	-- Cor Inicial (+ Vermelho = Sistema Desabilitado)
	statusIcon.TextColor3 = Color3.fromRGB(255, 0, 0)
	
	-- ==========================================
	-- SISTEMA DE NOTIFICAÇÃO
	-- ==========================================
	local function sendNotification(titleText, descText, sideColor)
		local guiParent = pcall(function() return CoreGui.Name end) and CoreGui or player:WaitForChild("PlayerGui")
	
		local notifGui = guiParent:FindFirstChild("CustomFlyNotif")
		if not notifGui then
			notifGui = Instance.new("ScreenGui")
			notifGui.Name = "CustomFlyNotif"
			notifGui.Parent = guiParent
		end
	
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(0, 300, 0, 65)
		frame.Position = UDim2.new(1, 20, 1, -120)
		frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		frame.BorderSizePixel = 0
		frame.Parent = notifGui
	
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = frame
	
		local sideBar = Instance.new("Frame")
		sideBar.Size = UDim2.new(0, 4, 1, 0)
		sideBar.Position = UDim2.new(1, -4, 0, 0)
		sideBar.BackgroundColor3 = sideColor
		sideBar.BorderSizePixel = 0
		sideBar.Parent = frame
		local sideCorner = Instance.new("UICorner")
		sideCorner.CornerRadius = UDim.new(0, 8)
		sideCorner.Parent = sideBar
	
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, -30, 0, 25)
		title.Position = UDim2.new(0, 15, 0, 8)
		title.BackgroundTransparency = 1
		title.Text = titleText
		title.TextColor3 = Color3.fromRGB(255, 255, 255)
		title.Font = Enum.Font.GothamBold
		title.TextSize = 14
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.Parent = frame
	
		local desc = Instance.new("TextLabel")
		desc.Size = UDim2.new(1, -30, 0, 25)
		desc.Position = UDim2.new(0, 15, 0, 32)
		desc.BackgroundTransparency = 1
		desc.Text = descText
		desc.TextColor3 = Color3.fromRGB(180, 180, 180)
		desc.Font = Enum.Font.Gotham
		desc.TextSize = 12
		desc.TextXAlignment = Enum.TextXAlignment.Left
		desc.Parent = frame
	
		local tweenIn = TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.new(1, -310, 1, -120)})
		tweenIn:Play()
	
		task.delay(2.5, function()
			local tweenOut = TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Position = UDim2.new(1, 20, 1, -120)})
			tweenOut:Play()
			tweenOut.Completed:Wait()
			frame:Destroy()
		end)
	end
	
	-- ==========================================
	-- LÓGICA DO VOO (FISICA)
	-- ==========================================
	local function cleanupFlyMovers()
		if rootPart then
			for _, obj in ipairs(rootPart:GetChildren()) do
				if obj.Name == FLY_VELOCITY_NAME or obj.Name == FLY_GYRO_NAME then
					obj:Destroy()
				end
			end
		end
		bodyVelocity = nil
		bodyGyro = nil
	end
	
	local function stopFlyingPhysics()
		isFlying = false
		if humanoid then humanoid.PlatformStand = false end
		cleanupFlyMovers()
	end
	
	local function startFlyingPhysics()
		cleanupFlyMovers()
		isFlying = true
		if humanoid then humanoid.PlatformStand = true end
	
		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.Name = FLY_VELOCITY_NAME
		bodyVelocity.Velocity = Vector3.new(0, 0, 0)
		bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bodyVelocity.Parent = rootPart
	
		bodyGyro = Instance.new("BodyGyro")
		bodyGyro.Name = FLY_GYRO_NAME
		bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		bodyGyro.P = 10000
		bodyGyro.Parent = rootPart
	end
	
	-- Alterna o voo (Chamado pela Tecla F ou Botão F Mobile)
	local function toggleActionF()
		if not systemEnabled then return end -- Se o painel não tiver ativado, não faz nada
		if os.clock() - lastToggle < 0.25 then return end
		lastToggle = os.clock()
	
		if isFlying then
			stopFlyingPhysics()
			sendNotification("VOO DESATIVADO", "Pressione [F] para voar novamente.", Color3.fromRGB(255, 170, 0))
		else
			startFlyingPhysics()
			sendNotification("VOANDO", "Modo de voo ativado!", Color3.fromRGB(50, 255, 50))
		end
	end
	
	-- ==========================================
	-- UI DO MOBILE (D-PAD + BOTÃO F)
	-- ==========================================
	local function createMobileUI()
		local guiParent = pcall(function() return CoreGui.Name end) and CoreGui or player:WaitForChild("PlayerGui")
	
		if guiParent:FindFirstChild("FlyControlsMobile") then
			guiParent.FlyControlsMobile:Destroy()
		end
	
		mobileGui = Instance.new("ScreenGui")
		mobileGui.Name = "FlyControlsMobile"
		mobileGui.ResetOnSpawn = false
		mobileGui.Enabled = false
		mobileGui.Parent = guiParent
	
		-- D-PAD (Esquerda)
		local dpadFrame = Instance.new("Frame")
		dpadFrame.Size = UDim2.new(0, 140, 0, 140)
		dpadFrame.Position = UDim2.new(0, 20, 0.5, 0)
		dpadFrame.BackgroundTransparency = 1
		dpadFrame.Parent = mobileGui
	
		local function createBtn(nome, texto, pos, pai, keyMap)
			local btn = Instance.new("TextButton")
			btn.Name = nome
			btn.Size = UDim2.new(0, 45, 0, 45)
			btn.Position = pos
			btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.TextScaled = true
			btn.Font = Enum.Font.SourceSansBold
			btn.Text = texto
			btn.Parent = pai
	
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 8)
			corner.Parent = btn
	
			btn.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
					if keyMap then btnInput[keyMap] = true end
					btn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
				end
			end)
			btn.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
					if keyMap then btnInput[keyMap] = false end
					btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
				end
			end)
		end
	
		-- Teclas WASD Mobile
		createBtn("BtnW", "W", UDim2.new(0.5, -22, 0, 0), dpadFrame, "W")
		createBtn("BtnA", "A", UDim2.new(0, 0, 0.5, -22), dpadFrame, "A")
		createBtn("BtnS", "S", UDim2.new(0.5, -22, 1, -45), dpadFrame, "S")
		createBtn("BtnD", "D", UDim2.new(1, -45, 0.5, -22), dpadFrame, "D")
	
		-- BOTÃO F DO MOBILE (Direita)
		local fButton = Instance.new("TextButton")
		fButton.Name = "BtnF"
		fButton.Size = UDim2.new(0, 65, 0, 65)
		fButton.Position = UDim2.new(1, -85, 0.5, -30)
		fButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		fButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		fButton.TextScaled = true
		fButton.Font = Enum.Font.SourceSansBold
		fButton.Text = "F"
		fButton.Parent = mobileGui
	
		local fCorner = Instance.new("UICorner")
		fCorner.CornerRadius = UDim.new(1, 0) -- Botão redondo
		fCorner.Parent = fButton
	
		fButton.MouseButton1Click:Connect(toggleActionF)
	end
	
	if isMobile then
		createMobileUI()
	end
	
	-- ==========================================
	-- BOTÃO PRINCIPAL DO PAINEL (Ligar/Desligar Master)
	-- ==========================================
	mainFlyButton.MouseButton1Click:Connect(function()
		systemEnabled = not systemEnabled
	
		if systemEnabled then
			-- ATIVOU NO PAINEL (+ Verde)
			statusIcon.TextColor3 = Color3.fromRGB(0, 255, 0)
			sendNotification("SISTEMA FLY HABILITADO", "Pressione [F] para iniciar o voo.", Color3.fromRGB(50, 255, 50))
			if mobileGui then mobileGui.Enabled = true end
		else
			-- DESATIVOU NO PAINEL (+ Vermelho)
			statusIcon.TextColor3 = Color3.fromRGB(255, 0, 0)
			stopFlyingPhysics()
			sendNotification("SISTEMA FLY DESABILITADO", "Recurso desligado.", Color3.fromRGB(255, 50, 50))
			if mobileGui then mobileGui.Enabled = false end
		end
	end)
	
	-- ESCUTAR A TECLA "F" NO TECLADO DO PC
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.KeyCode == Enum.KeyCode.F and not gameProcessed then
			toggleActionF()
		end
	end)
	
	-- ==========================================
	-- LOOP DE MOVIMENTAÇÃO
	-- ==========================================
	RunService.RenderStepped:Connect(function()
		if not isFlying or not bodyVelocity or not bodyGyro then return end
	
		local camera = workspace.CurrentCamera
		local moveDirection = Vector3.new(0, 0, 0)
		local camCF = camera.CFrame
	
		if UserInputService:IsKeyDown(Enum.KeyCode.W) or btnInput.W then moveDirection = moveDirection + camCF.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) or btnInput.S then moveDirection = moveDirection - camCF.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) or btnInput.A then moveDirection = moveDirection - camCF.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) or btnInput.D then moveDirection = moveDirection + camCF.RightVector end
	
		if moveDirection.Magnitude > 0 then
			moveDirection = moveDirection.Unit
		end
	
		bodyVelocity.Velocity = moveDirection * speed
	
		local forwardAmount = moveDirection:Dot(camCF.LookVector)
		local rightAmount = moveDirection:Dot(camCF.RightVector)
		local pitch = math.rad(-forwardAmount * 100)
		local roll = math.rad(-rightAmount * 80)
	
		bodyGyro.CFrame = camCF * CFrame.Angles(pitch, 0, roll)
	end)
	
	-- ==========================================
	-- RESET EM CASO DE MORTE
	-- ==========================================
	player.CharacterAdded:Connect(function(newCharacter)
		character = newCharacter
		humanoid = character:WaitForChild("Humanoid")
		rootPart = character:WaitForChild("HumanoidRootPart")
	
		systemEnabled = false
		isFlying = false
		statusIcon.TextColor3 = Color3.fromRGB(255, 0, 0)
		cleanupFlyMovers()
		if mobileGui then mobileGui.Enabled = false end
	end)
end;
