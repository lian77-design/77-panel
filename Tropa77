	-- [[ 25A. SISTEMA TAGDATA ]]
	-- ============================================================
	local tagdataExpiracoes={}
	
	local function dataParaTimestamp(str)
		local d,m,a=str:match("(%d+)/(%d+)/(%d+)")
		if not (d and m and a) then return nil end
		d,m,a=tonumber(d),tonumber(m),tonumber(a)
		local ok,ts=pcall(function() return os.time({year=a,month=m,day=d,hour=23,min=59,sec=59}) end)
		return ok and ts or nil
	end
	
	local function iniciarMonitorData(playerName, expireTs)
		task.spawn(function()
			while true do
				task.wait(30)
				if not tagdataExpiracoes[playerName] then return end
				if os.time()>=expireTs then
					local corUser=configuracaoTags["USER"]
					enviarTag(playerName,"USER",corUser)
					tagdataExpiracoes[playerName]=nil
					for _, p in pairs(Players:GetPlayers()) do
						if p.Name==playerName then
							aplicarTagVisual(p,"USER",corUser)
							if p==localPlayer then atualizarAbas("USER") end
							notificar("TAGDATA",p.DisplayName.." voltou para USER (data expirou)",5,"USER")
							break
						end
					end
					return
				end
			end
		end)
	end
	
