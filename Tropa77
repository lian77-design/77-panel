			lblVazio.Font               = Enum.Font.Gotham
			lblVazio.TextSize           = 11
			lblVazio.TextXAlignment     = Enum.TextXAlignment.Center
			table.insert(botoesStaff, lblVazio)
			staffScroll.CanvasSize = UDim2.new(0, 0, 0, offsetInicial + 56)
		end
