do
    local rootGui = G2L["1"]
    local PURPLE_DARK = Color3.fromRGB(18, 10, 28)
    local PURPLE_PANEL = Color3.fromRGB(28, 16, 42)
    local PURPLE_BUTTON = Color3.fromRGB(48, 27, 70)
    local LILAC = Color3.fromRGB(190, 145, 255)
    local LILAC_BRIGHT = Color3.fromRGB(220, 190, 255)
    local BLACK = Color3.fromRGB(8, 6, 12)

    local function apply77Theme(obj)
        if not obj:IsA("GuiObject") then return end

        if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
            obj.BackgroundColor3 = PURPLE_PANEL
        elseif obj:IsA("TextButton") or obj:IsA("ImageButton") then
            obj.BackgroundColor3 = PURPLE_BUTTON
            if obj:IsA("TextButton") then
                obj.TextColor3 = LILAC_BRIGHT
            end
        elseif obj:IsA("TextBox") then
            obj.BackgroundColor3 = BLACK
            obj.TextColor3 = LILAC_BRIGHT
            obj.PlaceholderColor3 = LILAC
        elseif obj:IsA("TextLabel") then
            if obj.Name == "VersionLabel" or obj.Name == "TitleLabel" then
                obj.TextColor3 = LILAC_BRIGHT
            elseif obj.BackgroundTransparency >= 0.99 then
                -- Preserve existing status colors on transparent labels.
            else
                obj.BackgroundColor3 = PURPLE_PANEL
            end
        end

        if obj:IsA("ScrollingFrame") then
            obj.ScrollBarImageColor3 = LILAC
        end
    end

    rootGui.DescendantAdded:Connect(apply77Theme)
    for _, obj in ipairs(rootGui:GetDescendants()) do
        apply77Theme(obj)
    end

    G2L["2"].BackgroundColor3 = PURPLE_DARK
    G2L["fa"].BackgroundColor3 = BLACK
    G2L["fb"].TextColor3 = LILAC_BRIGHT
    G2L["fc"].TextColor3 = LILAC_BRIGHT
end

