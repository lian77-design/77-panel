	-- LocalScript dentro do botão BANG (4E20 Panel)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local btnBang = script.Parent
	local sinalBang = btnBang:WaitForChild("TextLabel") -- Usa o indicador visual que está na árvore
	local scroll = btnBang.Parent
	local textBox = scroll:WaitForChild("@username") -- Detecta o @username nativo do seu painel
	
	local player = Players.LocalPlayer
	local looping = false
	local targetPlayer = nil
	local currentTime = 0
	
	-- Instanciando o ID da animação original em inglês corrigido
	local bangAnimation = Instance.new("Animation")
	bangAnimation.AnimationId = "rbxassetid://223623937"
	local animator = nil
	local bangTrack = nil
	
	-- Forças físicas estáveis do motor de grude
	local bPos = nil
	local bGyro = nil
	
	local COR_LIGADO    = Color3.fromRGB(0, 255, 0)
	local COR_DESLIGADO = Color3.fromRGB(255, 0, 0)
	
	-- Limpeza e Reset do motor de física
	local function limparForcasFisicas()
		if bPos then bPos:Destroy(); bPos = nil end
		if bGyro then bGyro:Destroy(); bGyro = nil end
	
		local meuChar = player.Character
		local meuHum = meuChar and meuChar:FindFirstChildOfClass("Humanoid")
		if meuHum then
			meuHum.Sit = false
			meuHum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end
		if meuChar then
			for _, parte in ipairs(meuChar:GetChildren()) do
				if parte:IsA("BasePart") then parte.CanCollide = true end
			end
		end
	end
	
	local function stopLoop()
		looping = false
		if bangTrack and bangTrack.IsPlaying then
			bangTrack:Stop()
		end
		bangTrack = nil
		limparForcasFisicas()
		sinalBang.TextColor3 = COR_DESLIGADO
	end
	
	local function findPlayer(name)
		if name == "" then return nil end
		name = string.lower(name)
		for _, p in pairs(Players:GetPlayers()) do
			if string.lower(p.Name):find(name, 1, true) or string.lower(p.DisplayName):find(name, 1, true) then
				return p
			end
		end
		return nil
	end
	
	-- Motor físico rítmico integrado com a animação original
	local function iniciarBang(targetName)
		local target = findPlayer(targetName)
		if not target or target == player then
			stopLoop()
			return false
		end
	
		targetPlayer = target
		looping = true
		sinalBang.TextColor3 = COR_LIGADO
	
		local meuChar = player.Character
		local meuRoot = meuChar and meuChar:FindFirstChild("HumanoidRootPart")
		local meuHum = meuChar and meuChar:FindFirstChildOfClass("Humanoid")
		if not meuRoot or not meuHum then return false end
	
		-- Garante o carregamento correto do Animator
		animator = meuHum:FindFirstChildOfClass("Animator") or Instance.new("Animator", meuHum)
		bangTrack = animator:LoadAnimation(bangAnimation)
		bangTrack.Priority = Enum.AnimationPriority.Action
		bangTrack.Looped = true
		bangTrack:Play()
	
		-- Configuração das forças para evitar lag de CFrame e fings
		bPos = Instance.new("BodyPosition")
		bPos.Name = "Bang_FisicoPos"
		bPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bPos.P = 65000
		bPos.D = 600
		bPos.Parent = meuRoot
	
		bGyro = Instance.new("BodyGyro")
		bGyro.Name = "Bang_FisicoGyro"
		bGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		bGyro.P = 15000
		bGyro.Parent = meuRoot
	
		task.spawn(function()
			currentTime = 0
			while looping and targetPlayer and targetPlayer.Character and player.Character do
				local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
				meuChar = player.Character
				meuRoot = meuChar and meuChar:FindFirstChild("HumanoidRootPart")
				meuHum = meuChar and meuChar:FindFirstChildOfClass("Humanoid")
	
				if not meuChar or not meuRoot or not meuHum then break end
	
				if not targetHRP or not targetPlayer.Character.Parent then
					bPos.Position = meuRoot.Position
					RunService.Heartbeat:Wait()
					continue
				end
	
				-- Desativa colisões para movimentação suave (Anti-Fling)
				for _, parte in ipairs(meuChar:GetChildren()) do
					if parte:IsA("BasePart") then parte.CanCollide = false end
				end
	
				meuHum.Sit = true
				meuHum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	
				-- O balanço do script original transportado para coordenadas físicas estáveis
				local baseOffset = CFrame.new(0, -0.3, 0.4) 
				local amplitude = 1.6
				local frequency = 8.5
				local offsetZ = amplitude * math.sin(currentTime * frequency)
				local extraOffset = CFrame.new(0, 0, offsetZ)
	
				local posicaoFinal = targetHRP.CFrame * baseOffset * extraOffset
				bPos.Position = posicaoFinal.Position
	
				-- Alinhamento de rotação plano
				local look = targetHRP.CFrame.LookVector
				bGyro.CFrame = CFrame.lookAt(meuRoot.Position, meuRoot.Position + Vector3.new(look.X, 0, look.Z))
	
				currentTime += RunService.Heartbeat:Wait()
			end
			if bangTrack then bangTrack:Stop() end
			limparForcasFisicas()
		end)
		return true
	end
	
	-- Gatilho de Ativar / Desativar do Botão do Painel
	btnBang.MouseButton1Click:Connect(function()
		if looping then
			stopLoop()
		else
			local alvoTexto = textBox.Text:gsub("%s+", "")
			if alvoTexto ~= "" then
				iniciarBang(alvoTexto)
			else
				stopLoop()
			end
		end
	end)
	
	player.CharacterRemoving:Connect(function()
		stopLoop()
	end)
end;
