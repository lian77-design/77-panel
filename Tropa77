			btnCard.MouseButton1Click:Connect(function()
				if spectandoPlayer == p then
					sairDoSpect()
					TweenService:Create(frame, TweenInfo.new(0.18), {BackgroundColor3=Color3.fromRGB(28,28,28)}):Play()
					stroke.Color         = Color3.fromRGB(50,50,50)
					dot.BackgroundColor3 = Color3.fromRGB(50,210,70)
				else
					for _, b in pairs(botoesStaff) do
						if b:IsA("Frame") and b ~= frame then
							TweenService:Create(b, TweenInfo.new(0.18), {BackgroundColor3=Color3.fromRGB(28,28,28)}):Play()
							local st = b:FindFirstChildOfClass("UIStroke")
							if st then st.Color = Color3.fromRGB(50,50,50) end
							local d = b:FindFirstChild("Dot")
							if d then d.BackgroundColor3 = Color3.fromRGB(50,210,70) end
						end
					end
					sairDoSpect()
					if p.Character then
