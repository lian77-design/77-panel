	-- ============================================================
	--[[
	  AnimationTela11 é acessível por TODOS os usuários, sem restrição.
	  O script detecta botões dentro da tela pelo nome e aplica a animação
	  correspondente ao personagem do localPlayer quando clicado.
	
	  Nomenclatura esperada dos botões na UI (FindFirstChild pelo Name):
	    Elder, Bold, Astronaut, Bubbly, Cartoony, Catwalk Glam,
	    Confident, Cowboy, Mage, Levitation
	  e qualquer outro botão que esteja dentro de AnimationTela11.
	
	  IDs das animações Roblox usados abaixo:
	    Elder        → 180435792
	    Bold         → 180435908
	    Astronaut    → 182042930
	    Bubbly       → 2510235   (Rthro Bubbly)
	    Cartoony     → 742638248
	    Catwalk Glam → 2510238
	    Confident    → 619522960
	    Cowboy       → 1099269
	    Mage         → 1083210
	    Levitation   → 616163682
	
	  Se o usuário clicar no mesmo botão novamente, o walk reset é removido
	  e o padrão do Roblox é restaurado (nil).
	]]
	
	local animacaoAtivaNome  = nil   -- nome da animação ativa
	local animBotaoAtivo     = nil   -- botão destacado atualmente
	
	local animacoesIDs = {
		["Elder"]        = 180435792,
		["Bold"]         = 180435908,
		["Astronaut"]    = 182042930,
		["Bubbly"]       = 2510235,
		["Cartoony"]     = 742638248,
		["Catwalk Glam"] = 2510238,
		["Confident"]    = 619522960,
		["Cowboy"]       = 1099269,
		["Mage"]         = 1083210,
		["Levitation"]   = 616163682,
	}
	
	local function resetarAnimacao()
		pcall(function()
			local char = localPlayer.Character
			if not char then return end
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if not humanoid then return end
			local animateScript = char:FindFirstChild("Animate")
			if animateScript then
				local walkAnim = animateScript:FindFirstChild("walk")
				if walkAnim then
					local animRef = walkAnim:FindFirstChild("WalkAnim")
					if animRef then animRef.AnimationId = "rbxassetid://913376220" end
				end
			end
			for _, track in pairs(humanoid.Animator:GetPlayingAnimationTracks()) do
				track:Stop()
			end
		end)
	end
	
	local function aplicarAnimacao(nomeAnim, animId)
		pcall(function()
			local char = localPlayer.Character
			if not char then return end
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if not humanoid then return end
			-- Tenta modificar o Animate script (walk)
			local animateScript = char:FindFirstChild("Animate")
			if animateScript then
				local walkAnim = animateScript:FindFirstChild("walk")
				if walkAnim then
					local animRef = walkAnim:FindFirstChild("WalkAnim")
					if animRef then
						animRef.AnimationId = "rbxassetid://"..tostring(animId)
					end
				end
				-- Força reload do Animate
				local clone = animateScript:Clone()
				animateScript:Destroy()
				clone.Parent = char
				clone.Disabled = false
			end
		end)
	end
	
	local function configurarBotoesAnimation()
		if not animationTela then return end
	
		-- Procura scroll frame ou usa a tela direto
		local scrollAnim = animationTela:FindFirstChildOfClass("ScrollingFrame") or animationTela
	
		for nomeBotao, animId in pairs(animacoesIDs) do
			local btn = scrollAnim:FindFirstChild(nomeBotao)
			-- Fallback: procura em toda a tela se não achou no scroll
			if not btn then btn = animationTela:FindFirstChild(nomeBotao) end
			if btn then
				btn.MouseButton1Click:Connect(function()
					if animacaoAtivaNome == nomeBotao then
						-- Clicou no mesmo → desativa
						animacaoAtivaNome = nil
						if animBotaoAtivo then
							animBotaoAtivo.BorderSizePixel = 0
							animBotaoAtivo = nil
						end
						resetarAnimacao()
						notificar("ANIMATION", "Animação removida", 3, meuCargo)
					else
						-- Troca de animação
						if animBotaoAtivo then
							animBotaoAtivo.BorderSizePixel = 0
						end
						animacaoAtivaNome = nomeBotao
						animBotaoAtivo    = btn
						btn.BorderSizePixel = 3
						btn.BorderColor3    = Color3.fromRGB(255, 255, 255)
						aplicarAnimacao(nomeBotao, animId)
						notificar("ANIMATION", "Animação: "..nomeBotao, 3, meuCargo)
					end
				end)
			end
		end
	end
	
	-- Reaplicar animação após respawn
	local function reconectarAnimacaoRespawn()
		localPlayer.CharacterAdded:Connect(function(char)
			if not animacaoAtivaNome then return end
			local animId = animacoesIDs[animacaoAtivaNome]
			if not animId then return end
			task.wait(2)  -- aguarda o Animate carregar
			aplicarAnimacao(animacaoAtivaNome, animId)
		end)
	end
	
