local DONO = "SEU_NOME_AQUI"  -- ← Coloque seu nome de usuário do Roblox
local ARQUIVO = "77cargos.json"

-- ═══════════════════════════════════════════════════
-- SISTEMA DE SALVAMENTO
-- ═══════════════════════════════════════════════════
local Cargos = {}

local function temArquivo()
    local ok = pcall(function() return readfile(ARQUIVO) end)
    return ok
end

local function salvarCargos()
    local ok, err = pcall(function()
        writefile(ARQUIVO, game:GetService("HttpService"):JSONEncode(Cargos))
    end)
    if ok then
        print("[77] Cargos salvos!")
    else
        warn("[77] Erro ao salvar: " .. tostring(err))
    end
end

local function carregarCargos()
    if temArquivo() then
        local ok, dados = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(ARQUIVO))
        end)
        if ok and dados then
            Cargos = dados
            print("[77] Cargos carregados!")
        else
            Cargos = {}
        end
    else
        Cargos = {}
        salvarCargos()
    end

    -- Garante que o Dono está sempre na lista
    Cargos[DONO] = "Dono"
    salvarCargos()
end

carregarCargos()

-- ═══════════════════════════════════════════════════
-- PERMISSÕES
-- ═══════════════════════════════════════════════════
local Nivel = {
    Dono  = 3,
    Admin = 2,
    VIP   = 1,
    User  = 0,
}

local function MeuCargo()
    return Cargos[LP.Name] or "User"
end

local function SouDono()
    return LP.Name == DONO
end

local function MeuNivel()
    return Nivel[MeuCargo()] or 0
end

local function PodeUsar(nivelMin)
    return MeuNivel() >= nivelMin
end-- ═══════════════════════════════════════════════════
-- FUNÇÕES DE CARGO
-- ═══════════════════════════════════════════════════

-- Dar cargo (SÓ O DONO)
local function DarCargo(nome, cargo)
    if not SouDono() then
        return false, "Só o Dono pode dar cargo"
    end
    if not Nivel[cargo] then
        return false, "Cargo inválido"
    end
    Cargos[nome] = cargo
    salvarCargos()
    return true, nome .. " virou " .. cargo
end

-- Remover cargo
local function RemoverCargo(nome)
    if not SouDono() then
        return false, "Só o Dono pode remover"
    end
    if nome == DONO then
        return false, "Não pode remover o Dono"
    end
    Cargos[nome] = nil
    salvarCargos()
    return true, "Cargo de " .. nome .. " removido"
end

-- Listar cargos
local function ListarCargos()
    local lista = {}
    for nome, cargo in pairs(Cargos) do
        table.insert(lista, nome .. " → " .. cargo)
    end
    return lista
end

-- Criação de UI básica (pra montar o painel)
local function novo(classe, props, pai)
    local i = Instance.new(classe)
    for k, v in pairs(props) do i[k] = v end
    i.Parent = pai
    return i
end

local function borda(obj, raio)
    local u = Instance.new("UICorner")
    u.CornerRadius = UDim.new(0, raio)
    u.Parent = obj
end

local function stroke(obj, cor, esp)
    local s = Instance.new("UIStroke")
    s.Color = cor
    s.Thickness = esp
    s.Parent = obj
    return s
end

